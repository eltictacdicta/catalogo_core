{#
/**
 * Plugin: catalogo_core
 * Admin-only general options page (multitarifa, R-CO-004). Edits all
 * CatalogoOptions-managed options in one form: multi-tariff flag, role-groups
 * master flag and the Excel granted roles.
 *
 * Twig nativo con autoescape (sin filtros que salteen el escape con datos de
 * usuario). El POST es CSRF-protegido vía csrf_field() y el controlador
 * valida el token antes de persistir.
 */
#}
{% include 'header.html.twig' %}

<div class="container">
   <div class="row">
      <div class="col-sm-8 col-sm-offset-2">
         <div class="page-header">
            <h1><i class="fa fa-cogs" aria-hidden="true"></i>&nbsp; Opciones de catálogo</h1>
            <p class="help-block">
               Opciones generales del catálogo de artículos: multi-tarifa, grupos
               de acceso a precios y autorizaciones del Excel.
            </p>
         </div>

         <form action="{{ fsc.url() }}" method="post" class="form" role="form">
            {{ csrf_field() }}
            <div class="panel panel-default">
               <div class="panel-heading">
                  <h3 class="panel-title">Multi-tarifa</h3>
               </div>
               <div class="panel-body">
                  <div class="checkbox">
                     <label>
                        <input type="hidden" name="multi_tariff" value="FALSE" />
                        <input type="checkbox" name="multi_tariff" value="TRUE" {% if fsc.multi_tariff %}checked{% endif %} />
                        Activar precios por lista de precio (multi-tarifa)
                     </label>
                  </div>
                  <p class="help-block">
                     Desactivada, las listas de precio y los precios por artículo quedan ocultos.
                  </p>
               </div>
            </div>

            <div class="panel panel-default">
               <div class="panel-heading">
                  <h3 class="panel-title">Grupos de acceso a precios</h3>
               </div>
               <div class="panel-body">
                  <div class="checkbox">
                     <label>
                        <input type="hidden" name="groups_enabled" value="FALSE" />
                        <input type="checkbox" name="groups_enabled" value="TRUE" {% if fsc.groups_enabled %}checked{% endif %} />
                        Activar el filtrado por grupos de acceso a precios
                     </label>
                  </div>
                  <p class="help-block">
                     Desactivado, el filtro por grupos queda inerte (todos los usuarios pueden editar).
                  </p>
               </div>
            </div>

            <div class="panel panel-default">
               <div class="panel-heading">
                  <h3 class="panel-title">Excel de artículos — acceso</h3>
               </div>
               <div class="panel-body">
                  <p><strong>Administradores:</strong> acceso siempre permitido.</p>
                  {% if fsc.roles|length > 0 %}
                     <label>Roles con acceso al Excel de artículos</label>
                     {% for rol in fsc.roles %}
                     <div class="checkbox">
                        <label>
                           <input type="checkbox" name="catalogo_excel_roles[]" value="{{ rol.codrol }}"
                                  {% if rol.codrol in fsc.granted_codes %}checked{% endif %} />
                           {{ rol.descripcion }} <span class="text-muted">({{ rol.codrol }})</span>
                        </label>
                     </div>
                     {% endfor %}
                  {% else %}
                  <p class="help-block">No hay roles definidos en el sistema.</p>
                  {% endif %}
               </div>
            </div>

            <div class="text-right">
               <button class="btn btn-primary" type="submit">
                  <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar
               </button>
            </div>
         </form>
      </div>
   </div>
</div>

{% include 'footer.html.twig' %}
