{#
/**
 * Plugin: catalogo_core
 * Pantalla admin-only para configurar qué roles (fs_roles) pueden importar
 * y exportar el catálogo de artículos en Excel (catalogo_excel_roles).
 *
 * Twig nativo con autoescape (sin filtros que salteen el escape con datos de
 * usuario). El POST es CSRF-protegido vía csrf_field() y el controlador valida
 * el token antes de persistir.
 */
#}
{% include 'header.html.twig' %}

<div class="container">
   <div class="row">
      <div class="col-sm-8 col-sm-offset-2">
         <div class="page-header">
            <h1>
               <i class="fa fa-file-excel-o" aria-hidden="true"></i>&nbsp; Excel de artículos — acceso
            </h1>
            <p class="help-block">
               Los administradores siempre pueden importar y exportar el catálogo
               de artículos en Excel. Desde aquí puedes autorizar roles adicionales
               de <code>fs_roles</code>.
            </p>
         </div>

         <div class="panel panel-default">
            <div class="panel-heading">
               <h3 class="panel-title">Política actual</h3>
            </div>
            <div class="panel-body">
               <p><strong>Administradores:</strong> acceso siempre permitido.</p>
               {% if fsc.granted_roles|length > 0 %}
               <p><strong>Roles autorizados:</strong></p>
               <ul>
                  {% for rol in fsc.granted_roles %}
                  <li>{{ rol.descripcion }} <span class="text-muted">({{ rol.codrol }})</span></li>
                  {% endfor %}
               </ul>
               {% else %}
               <p class="help-block">Ningún rol autorizado: solo los administradores pueden importar/exportar.</p>
               {% endif %}
            </div>
         </div>

         <form action="{{ fsc.url() }}" method="post" class="form" role="form">
            {{ csrf_field() }}
            <div class="form-group">
               <label>Roles con acceso al Excel de artículos</label>
               {% if fsc.roles|length > 0 %}
                  {% for rol in fsc.roles %}
                  <div class="checkbox">
                     <label>
                        <input type="checkbox" name="catalogo_excel_roles[]" value="{{ rol.codrol }}"
                               {% if rol.codrol in fsc.granted_codes %}checked{% endif %} />
                        {{ rol.descripcion }} <span class="text-muted">({{ rol.codrol }})</span>
                     </label>
                  </div>
                  {% endfor %}
               {% else %}
               <p class="help-block">No hay roles definidos en el sistema.</p>
               {% endif %}
            </div>
            <div class="text-right">
               <button class="btn btn-sm btn-primary" type="submit">
                  <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar
               </button>
            </div>
         </form>
      </div>
   </div>
</div>

{% include 'footer.html.twig' %}