<?xml version="1.0" encoding="UTF-8"?>
<!--
    Listas de precio nombradas del catálogo (ancla para opcionales y compatibilidad con tarifario).
-->
<tabla>
    <columna>
        <nombre>codlista</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>nombre</nombre>
        <tipo>character varying(50)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>activa</nombre>
        <tipo>boolean</tipo>
        <nulo>YES</nulo>
        <defecto>true</defecto>
    </columna>
    <columna>
        <nombre>por_defecto</nombre>
        <tipo>boolean</tipo>
        <nulo>YES</nulo>
        <defecto>false</defecto>
    </columna>
    <columna>
        <nombre>coddivisa</nombre>
        <tipo>character varying(3)</tipo>
        <nulo>NO</nulo>
        <defecto>EUR</defecto>
    </columna>
    <restriccion>
        <nombre>catalogo_listas_precio_pkey</nombre>
        <consulta>PRIMARY KEY (codlista)</consulta>
    </restriccion>
</tabla>
