<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tabla tarif_tarifa_articulo_etiqueta: Etiquetas asignadas a artículos por tarifa.
-->
<tabla>
    <columna>
        <nombre>codtarifa</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>referencia</nombre>
        <tipo>character varying(18)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>etiqueta</nombre>
        <tipo>character varying(60)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>tarif_tarifa_articulo_etiqueta_pkey</nombre>
        <consulta>PRIMARY KEY (codtarifa, referencia, etiqueta)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_tarif_tarifa_articulo_etiqueta_tarifa</nombre>
        <consulta>FOREIGN KEY (codtarifa)
            REFERENCES tarif_tarifas (codtarifa)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_tarif_tarifa_articulo_etiqueta_articulo</nombre>
        <consulta>FOREIGN KEY (referencia)
            REFERENCES articulos (referencia)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
</tabla>
