<?xml version="1.0" encoding="UTF-8"?>
<!--
    Opcionales del catálogo asociables a artículos y familias.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>codigo</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>nombre</nombre>
        <tipo>character varying(100)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>descripcion</nombre>
        <tipo>text</tipo>
        <nulo>YES</nulo>
    </columna>
    <columna>
        <nombre>precio</nombre>
        <tipo>double precision</tipo>
        <nulo>YES</nulo>
        <defecto>0</defecto>
    </columna>
    <columna>
        <nombre>tipo_precio</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
        <defecto>fijo</defecto>
    </columna>
    <columna>
        <nombre>porcentaje</nombre>
        <tipo>double precision</tipo>
        <nulo>YES</nulo>
    </columna>
    <columna>
        <nombre>activo</nombre>
        <tipo>boolean</tipo>
        <nulo>YES</nulo>
        <defecto>true</defecto>
    </columna>
    <columna>
        <nombre>id_grupo</nombre>
        <tipo>integer</tipo>
        <nulo>YES</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_opcionales_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>catalogo_opcionales_codigo_unique</nombre>
        <consulta>UNIQUE (codigo)</consulta>
    </restriccion>
</tabla>
