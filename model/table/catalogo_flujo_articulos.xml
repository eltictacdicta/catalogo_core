<?xml version="1.0" encoding="UTF-8"?>
<!--
    Asignación M:N flujo ↔ artículo.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>id_flujo</nombre>
        <tipo>integer</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>referencia</nombre>
        <tipo>character varying(18)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_flujo_articulos_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>catalogo_flujo_articulos_unique</nombre>
        <consulta>UNIQUE (id_flujo, referencia)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_flujo_articulos_flujo</nombre>
        <consulta>FOREIGN KEY (id_flujo)
            REFERENCES catalogo_flujos (id)
            ON DELETE CASCADE</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_flujo_articulos_articulos</nombre>
        <consulta>FOREIGN KEY (referencia)
            REFERENCES articulos (referencia)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
</tabla>
