<?xml version="1.0" encoding="UTF-8"?>
<!--
    Relación artículo ↔ grupo de opcionales.
    Los opcionales del grupo se eligen en venta (p. ej. Color: Blanco o Rojo).
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>referencia</nombre>
        <tipo>character varying(18)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>id_grupo</nombre>
        <tipo>integer</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>obligatorio</nombre>
        <tipo>boolean</tipo>
        <nulo>NO</nulo>
        <defecto>false</defecto>
    </columna>
    <restriccion>
        <nombre>catalogo_articulo_opcional_grupo_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>catalogo_articulo_opcional_grupo_unique</nombre>
        <consulta>UNIQUE (referencia, id_grupo)</consulta>
    </restriccion>
</tabla>
