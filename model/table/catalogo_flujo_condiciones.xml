<?xml version="1.0" encoding="UTF-8"?>
<!--
    Condiciones de un flujo. El sujeto se referencia por código (opcional o
    grupo); no hay FK de base de datos porque tiene dos padres posibles: la
    integridad es de la aplicación.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>id_flujo</nombre>
        <tipo>integer</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>grupo_and_or</nombre>
        <tipo>character varying(3)</tipo>
        <nulo>NO</nulo>
        <defecto>AND</defecto>
    </columna>
    <columna>
        <nombre>sujeto_tipo</nombre>
        <tipo>character varying(10)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>sujeto_codigo</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>operador</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>valor</nombre>
        <tipo>character varying(255)</tipo>
        <nulo>YES</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_flujo_condiciones_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_flujo_condiciones_flujo</nombre>
        <consulta>FOREIGN KEY (id_flujo)
            REFERENCES catalogo_flujos (id)
            ON DELETE CASCADE</consulta>
    </restriccion>
</tabla>
