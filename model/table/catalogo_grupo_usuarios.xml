<?xml version="1.0" encoding="UTF-8"?>
<!--
    Membresía de usuarios en grupos de acceso a precios (rol dentro del grupo).
-->
<tabla>
    <columna>
        <nombre>id_grupo</nombre>
        <tipo>integer</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>nick</nombre>
        <tipo>character varying(50)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>rol</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_grupo_usuarios_pkey</nombre>
        <consulta>PRIMARY KEY (id_grupo, nick)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_grupo_usuarios_grupo</nombre>
        <consulta>FOREIGN KEY (id_grupo)
            REFERENCES catalogo_grupo (id)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
</tabla>
