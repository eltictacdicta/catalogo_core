<?xml version="1.0" encoding="UTF-8"?>
<!--
    Idiomas disponibles para descripciones multiidioma de artículos.
-->
<tabla>
    <columna>
        <nombre>codidioma</nombre>
        <tipo>character varying(5)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>nombre</nombre>
        <tipo>character varying(50)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>activo</nombre>
        <tipo>boolean</tipo>
        <nulo>YES</nulo>
        <defecto>true</defecto>
    </columna>
    <columna>
        <nombre>por_defecto</nombre>
        <tipo>boolean</tipo>
        <nulo>YES</nulo>
        <defecto>false</defecto>
    </columna>
    <restriccion>
        <nombre>catalogo_idiomas_pkey</nombre>
        <consulta>PRIMARY KEY (codidioma)</consulta>
    </restriccion>
</tabla>
