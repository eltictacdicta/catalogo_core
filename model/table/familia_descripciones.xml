<?xml version="1.0" encoding="UTF-8"?>
<!--
    Descripciones multiidioma de familias. El idioma por defecto sigue
    viviendo en familias.descripcion; aquí van las traducciones.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>codfamilia</nombre>
        <tipo>character varying(8)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>codidioma</nombre>
        <tipo>character varying(5)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>descripcion</nombre>
        <tipo>character varying(100)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>familia_descripciones_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>familia_descripciones_unique</nombre>
        <consulta>UNIQUE (codfamilia, codidioma)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_familia_descripciones_familias</nombre>
        <consulta>FOREIGN KEY (codfamilia)
            REFERENCES familias (codfamilia)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
</tabla>
