<?xml version="1.0" encoding="UTF-8"?>
<!--
    Nombre multiidioma de un grupo de opcionales.
    Misma convención que catalogo_opcional_idiomas: clave natural
    (codigo, codidioma) y cascada al borrar/renombrar el grupo. El idioma por
    defecto vive en catalogo_opcional_grupos.nombre; aquí solo el resto.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>codigo</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>codidioma</nombre>
        <tipo>character varying(5)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>nombre</nombre>
        <tipo>character varying(100)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_opcional_grupo_idiomas_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>catalogo_opcional_grupo_idiomas_unique</nombre>
        <consulta>UNIQUE (codigo, codidioma)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_opcional_grupo_idiomas_grupos</nombre>
        <consulta>FOREIGN KEY (codigo)
            REFERENCES catalogo_opcional_grupos (codigo)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
</tabla>
