<?xml version="1.0" encoding="UTF-8"?>
<!--
    Asignación M:N flujo ↔ familia.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>id_flujo</nombre>
        <tipo>integer</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>codfamilia</nombre>
        <tipo>character varying(8)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_flujo_familias_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>catalogo_flujo_familias_unique</nombre>
        <consulta>UNIQUE (id_flujo, codfamilia)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_flujo_familias_flujo</nombre>
        <consulta>FOREIGN KEY (id_flujo)
            REFERENCES catalogo_flujos (id)
            ON DELETE CASCADE</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_flujo_familias_familias</nombre>
        <consulta>FOREIGN KEY (codfamilia)
            REFERENCES familias (codfamilia)
            ON DELETE CASCADE ON UPDATE CASCADE</consulta>
    </restriccion>
</tabla>
