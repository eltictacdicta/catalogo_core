<?xml version="1.0" encoding="UTF-8"?>
<!--
    Acciones de un flujo. El sujeto se referencia por código (opcional o
    grupo); no hay FK de base de datos (dos padres posibles), integridad de
    aplicación.
-->
<tabla>
    <columna>
        <nombre>id</nombre>
        <tipo>serial</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>id_flujo</nombre>
        <tipo>integer</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>accion</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>sujeto_tipo</nombre>
        <tipo>character varying(10)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>sujeto_codigo</nombre>
        <tipo>character varying(20)</tipo>
        <nulo>NO</nulo>
    </columna>
    <restriccion>
        <nombre>catalogo_flujo_acciones_pkey</nombre>
        <consulta>PRIMARY KEY (id)</consulta>
    </restriccion>
    <restriccion>
        <nombre>ca_catalogo_flujo_acciones_flujo</nombre>
        <consulta>FOREIGN KEY (id_flujo)
            REFERENCES catalogo_flujos (id)
            ON DELETE CASCADE</consulta>
    </restriccion>
</tabla>
