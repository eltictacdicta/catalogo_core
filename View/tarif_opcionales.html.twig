{% include 'header.html.twig' %}

<script type="text/javascript">
   function show_nuevo_opcional()
   {
      $("#modal_nuevo_opcional").modal('show');
      document.f_nuevo_opcional.codigo.focus();
   }

   function eliminar_opcional(id, nombre)
   {
      bootbox.confirm({
         message: '¿Realmente desea eliminar el opcional "'+nombre+'"?',
         title: '<b>Atención</b>',
         callback: function(result) {
            if (result) {
               window.location.href = '{{ fsc.url() }}&delete='+id;
            }
         }
      });
   }

   $(document).ready(function() {
      document.f_buscar.query.focus();

      if(window.location.hash.substring(1) == 'nuevo')
      {
         show_nuevo_opcional();
      }

      $("#b_nuevo_opcional").click(function(event) {
         event.preventDefault();
         show_nuevo_opcional();
      });
   });
</script>

<div class="container-fluid" style="margin-bottom: 10px;">
   <div class="row">
      <div class="col-xs-12">
         <div class="btn-group hidden-xs">
            <a class="btn btn-sm btn-default" href="{{ fsc.url() }}" title="Recargar la página">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
         </div>
         <div class="btn-group">
            <a id="b_nuevo_opcional" class="btn btn-sm btn-success" href="#">
               <span class="glyphicon glyphicon-plus"></span>
               <span class="hidden-xs">&nbsp;Nuevo opcional</span>
            </a>
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="index.php?page=tarif_articulos">
               <span class="glyphicon glyphicon-th-list"></span>
               <span class="hidden-xs">&nbsp;Artículos</span>
            </a>
            <a class="btn btn-sm btn-default" href="index.php?page=tarif_familias">
               <i class="fa fa-folder-open-o"></i>
               <span class="hidden-xs">&nbsp;Familias</span>
            </a>
         </div>
         <div class="btn-group">
            <a id="b_exportar_excel" class="btn btn-sm btn-success" href="#" data-toggle="modal" data-target="#modal_exportar_excel_opcionales">
               <i class="fa fa-file-excel-o"></i>
               <span class="hidden-xs">&nbsp;Exportar Excel</span>
            </a>
         </div>
      </div>
   </div>
</div>

<div class="container-fluid">
   <form name="f_buscar" action="{{ fsc.url() }}" method="post" class="form">
      <div class="row">
         <div class="col-sm-2">
            <div class="form-group{% if fsc.query %} has-success{% endif %}">
               <div class="input-group">
                  <input class="form-control" type="text" name="query" value="{{ fsc.query }}" autocomplete="off" placeholder="Buscar...">
                  <span class="input-group-btn">
                     <button class="btn btn-primary" type="submit">
                        <span class="glyphicon glyphicon-search"></span>
                     </button>
                  </span>
               </div>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group{% if fsc.b_codfamilia %} has-success{% endif %}">
               <select class="form-control" name="b_codfamilia" onchange="this.form.submit()">
                  <option value="">Todas las familias</option>
                  <option value="">-----</option>
                  {% for fam in fsc.familia.all() %}
                     <option value="{{ fam.codfamilia }}"{% if fam.codfamilia == fsc.b_codfamilia %} selected{% endif %}>{{ fam.nivel }}{{ fam.descripcion }}</option>
                  {% endfor %}
               </select>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group{% if fsc.b_codtarifa %} has-success{% endif %}">
               <select class="form-control" name="b_codtarifa" onchange="this.form.submit()" title="Tarifa de precios">
                  {% for tarifa in fsc.tarifas %}
                     <option value="{{ tarifa.codtarifa }}"{% if tarifa.codtarifa == fsc.b_codtarifa %} selected{% endif %}>{{ tarifa.nombre }}{% if tarifa.por_defecto %} ★{% endif %}</option>
                  {% endfor %}
               </select>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group">
               <label class="checkbox-inline">
                  <input type="checkbox" name="b_solo_activos" value="TRUE" onchange="this.form.submit()"{% if fsc.b_solo_activos %} checked{% endif %}/>
                  Solo activos en tarifa
               </label>
            </div>
         </div>
         <div class="col-sm-4 text-right">
            <span class="badge">{{ fsc.total_resultados }} opcionales</span>
         </div>
      </div>
   </form>
</div>

<div class="table-responsive">
   <table class="table table-hover">
      <thead>
         <tr>
            <th class="text-left">Código</th>
            <th class="text-left">Ref ERP</th>
            <th class="text-left">Nombre</th>
            <th class="text-left">Familias</th>
            <th class="text-right">
               Precio
               {% if fsc.tarifa_seleccionada %}
               <small class="text-muted">({{ fsc.tarifa_seleccionada.nombre }})</small>
               {% endif %}
            </th>
            <th class="text-center">Estado</th>
            <th class="text-center">
               Tarifa
               <small class="text-muted">({{ fsc.tarifa_seleccionada.nombre }})</small>
            </th>
            <th class="text-center">Catálogo</th>
            <th class="text-right"></th>
         </tr>
      </thead>
      {% for value in fsc.resultados %}
      <tr class="clickableRow{% if not fsc.opcional_activo_en_tarifa(value.id) %} warning{% elseif not value.activo %} danger{% endif %}" href="index.php?page=tarif_opcional_precios&id={{ value.id }}&codtarifa={{ fsc.b_codtarifa }}">
         <td>
            <a href="{{ value.url() }}">{{ value.codigo }}</a>
         </td>
         <td>
            {% if value.ref_sap %}
            <span class="text-muted">{{ value.ref_sap }}</span>
            {% else %}
            <span class="text-muted">-</span>
            {% endif %}
         </td>
         <td>
            {{ value.nombre }}
         </td>
         <td>
            {% set familias = value.get_familias() %}
            {% if familias|length > 0 %}
               {% for fam in familias %}
                  <span class="label label-info">{{ fam.codfamilia }}</span>
               {% endfor %}
            {% else %}
               <span class="text-muted">-</span>
            {% endif %}
         </td>
         <td class="text-right">
            {% if fsc.opcional_activo_en_tarifa(value.id) %}
            <a href="index.php?page=tarif_opcional_precios&id={{ value.id }}&codtarifa={{ fsc.b_codtarifa }}" class="cancel_clickable" title="Ver/editar precios en {{ fsc.tarifa_seleccionada.nombre }}">
               {{ fsc.show_precio(fsc.get_precio_opcional_tarifa(value.id), false, true, constant('FS_NF0_ART')) }}
            </a>
            {% else %}
            <span class="text-muted">-</span>
            {% endif %}
         </td>
         <td class="text-center">
            {% if value.activo %}
            <span class="label label-success">Activo</span>
            {% else %}
            <span class="label label-danger">Inactivo</span>
            {% endif %}
         </td>
         <td class="text-center">
            {% if fsc.opcional_activo_en_tarifa(value.id) %}
            <span class="glyphicon glyphicon-ok text-success" title="Activo en {{ fsc.tarifa_seleccionada.nombre }}"></span>
            {% else %}
            <span class="glyphicon glyphicon-remove text-muted" title="No configurado en {{ fsc.tarifa_seleccionada.nombre }}"></span>
            {% endif %}
         </td>
         <td class="text-center">
            {% if fsc.opcional_en_catalogo_tarifa(value.id) %}
            <span class="glyphicon glyphicon-ok text-success" title="En catálogo de {{ fsc.tarifa_seleccionada.nombre }}"></span>
            {% else %}
            <span class="glyphicon glyphicon-remove text-muted"></span>
            {% endif %}
         </td>
         <td class="text-right">
            <div class="btn-group btn-group-xs">
               <a href="index.php?page=tarif_opcional_precios&id={{ value.id }}&codtarifa={{ fsc.b_codtarifa }}" class="btn btn-info cancel_clickable" title="Precios en {{ fsc.tarifa_seleccionada.nombre }}">
                  <span class="glyphicon glyphicon-tags"></span>
               </a>
               <a href="{{ value.url() }}" class="btn btn-default cancel_clickable" title="Editar datos generales">
                  <span class="glyphicon glyphicon-edit"></span>
               </a>
               {% if fsc.allow_delete %}
               <a href="#" class="btn btn-danger cancel_clickable" onclick="eliminar_opcional({{ value.id }}, '{{ value.nombre|e('js') }}')" title="Eliminar">
                  <span class="glyphicon glyphicon-trash"></span>
               </a>
               {% endif %}
            </div>
         </td>
      </tr>
      {% else %}
      <tr class="warning">
         <td colspan="9">Ningún opcional encontrado. Pulsa el botón <b>Nuevo opcional</b> para crear uno.</td>
      </tr>
      {% endfor %}
   </table>
</div>

<div class="text-center">
   <ul class="pagination">
      {% for page in fsc.paginas() %}
      <li{% if page.actual %} class="active"{% endif %}>
         <a href="{{ page.url }}">{{ page.num }}</a>
      </li>
      {% endfor %}
   </ul>
</div>

{# Modal Nuevo Opcional #}
<form class="form-horizontal" role="form" name="f_nuevo_opcional" action="{{ fsc.url() }}" method="post">
   <div class="modal" id="modal_nuevo_opcional">
      <div class="modal-dialog modal-lg">
         <div class="modal-content">
            <div class="modal-header">
               <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
               <h4 class="modal-title">Nuevo opcional</h4>
            </div>
            <div class="modal-body">
               <div class="form-group">
                  <label class="col-sm-2 control-label">Código</label>
                  <div class="col-sm-10">
                     <input class="form-control" type="text" name="codigo" maxlength="20" autocomplete="off"/>
                     <p class="help-block">Dejar en blanco para asignar automáticamente.</p>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label">REF</label>
                  <div class="col-sm-10">
                     <input class="form-control" type="text" name="ref_sap" maxlength="50" autocomplete="off" placeholder="SKU / Referencia SAP"/>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label">Nombre</label>
                  <div class="col-sm-10">
                     <input class="form-control" type="text" name="nombre" maxlength="100" autocomplete="off" required/>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-2 control-label">Descripción</label>
                  <div class="col-sm-10">
                     <textarea class="form-control" name="descripcion" rows="2"></textarea>
                  </div>
               </div>
               {% if fsc.tarifas|length > 0 %}
               <hr/>
               <h5><b>Precios por tarifa</b></h5>
               {% for tarifa in fsc.tarifas %}
               <div class="form-group">
                  <label class="col-sm-4 control-label">
                     {{ tarifa.nombre }}
                     {% if tarifa.por_defecto %}<span class="label label-primary label-xs">defecto</span>{% endif %}
                  </label>
                  <div class="col-sm-4">
                     <div class="input-group">
                        <input class="form-control" type="text" name="precio_tarifa_{{ tarifa.codtarifa }}" value="" autocomplete="off" placeholder="0.00"/>
                        <div class="input-group-addon">{{ fsc.simbolo_divisa(fsc.codtarifa) }}</div>
                     </div>
                  </div>
               </div>
               {% endfor %}
               {% else %}
               <div class="form-group">
                  <div class="col-sm-12">
                     <div class="alert alert-warning">
                        <i class="fa fa-warning"></i> No hay tarifas definidas.
                        <a href="index.php?page=tarif_tarifas">Crear tarifas</a> para poder asignar precios.
                     </div>
                  </div>
               </div>
               {% endif %}
               <hr/>
               <div class="form-group">
                  <label class="col-sm-2 control-label">Familias</label>
                  <div class="col-sm-10">
                     <select class="form-control" name="familias[]" multiple size="6">
                        {% for fam in fsc.familia.all() %}
                        <option value="{{ fam.codfamilia }}">{{ fam.nivel }}{{ fam.descripcion }}</option>
                        {% endfor %}
                     </select>
                     <p class="help-block">Mantén Ctrl para seleccionar varias familias.</p>
                  </div>
               </div>
            </div>
            <div class="modal-footer">
               <button class="btn btn-sm btn-primary" type="submit">
                  <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar
               </button>
            </div>
         </div>
      </div>
   </div>
</form>

{# Modal Exportar Excel Opcionales #}
<div class="modal" id="modal_exportar_excel_opcionales" data-backdrop="static">
   <div class="modal-dialog">
      <div class="modal-content">
         <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 class="modal-title">
               <i class="fa fa-file-excel-o text-success"></i> Exportar Opcionales a Excel
            </h4>
         </div>
         <div class="modal-body">
            <div class="alert alert-info">
               <i class="fa fa-info-circle"></i>
               <strong>Exportación de Opcionales:</strong>
               <p style="margin-top: 10px; margin-bottom: 0;">
                  Exporta los opcionales con las columnas: <strong>Codigo (No editar), Ref SAP:, Descripción, Precio, Familia y Subfamilia</strong>.
               </p>
            </div>

            {% if fsc.tarifa_seleccionada %}
            <div class="form-group">
               <label>Tarifa:</label>
               <p class="form-control-static">
                  <strong>{{ fsc.tarifa_seleccionada.nombre }}</strong>
                  <span class="text-muted">({{ fsc.tarifa_seleccionada.codtarifa }})</span>
               </p>
            </div>
            {% else %}
            <div class="alert alert-warning">
               <i class="fa fa-warning"></i> No hay tarifa seleccionada. Los precios se exportarán como 0.
            </div>
            {% endif %}
         </div>
         <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">
               <i class="fa fa-times"></i> Cancelar
            </button>
            <a href="{{ fsc.url() }}&action=export_excel_opcionales&codtarifa={{ fsc.b_codtarifa }}" class="btn btn-success">
               <i class="fa fa-download"></i> Exportar Excel
            </a>
         </div>
      </div>
   </div>
</div>

{% include 'footer.html.twig' %}
