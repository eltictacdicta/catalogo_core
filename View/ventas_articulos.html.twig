{{ include('header.html.twig') }}

<script type="text/javascript">
function show_nuevo_articulo() {
    $('#modal_nuevo_articulo').modal('show');
    if (document.f_nuevo_articulo && document.f_nuevo_articulo.nreferencia) {
        document.f_nuevo_articulo.nreferencia.focus();
    }
}

$(document).ready(function() {
    if (window.location.hash.substring(1) === 'nuevo') {
        show_nuevo_articulo();
    }

    $('#b_nuevo_articulo').click(function(event) {
        event.preventDefault();
        show_nuevo_articulo();
    });
});
</script>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-header">
                <h1>
                    <i class="fa fa-cube" aria-hidden="true"></i>&nbsp; {{ 'articles'|trans }}
                    <span class="badge">{{ fsc.resultados|length }}</span>
                    <a class="btn btn-xs btn-default" href="{{ fsc.url() }}" title="{{ 'reload'|trans }}">
                        <span class="glyphicon glyphicon-refresh"></span>
                    </a>
                    <a id="b_nuevo_articulo" class="btn btn-xs btn-success" href="#" title="{{ 'new-article'|trans }}">
                        <span class="glyphicon glyphicon-plus"></span>
                        <span class="hidden-xs">&nbsp;{{ 'new-article'|trans }}</span>
                    </a>
                    <span class="btn-group">
                        {% if fsc.can_import_export %}
                        <div class="btn-group">
                            <button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" title="{{ 'excel-menu'|trans }}">
                                <i class="fa fa-file-excel-o text-success"></i> Excel <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" role="menu">
                                <li><a href="#" data-toggle="modal" data-target="#modal-exportar-articulos-excel"><i class="fa fa-download fa-fw"></i> {{ 'excel-export-title'|trans }}</a></li>
                                <li><a href="#" data-toggle="modal" data-target="#modal-importar-articulos-excel"><i class="fa fa-upload fa-fw"></i> {{ 'excel-import-wizard-title'|trans }}</a></li>
                            </ul>
                        </div>
                        {% endif %}
                        {% for ext in fsc.extensions %}
                            {% if ext.type == 'button' %}
                            <a href="index.php?page={{ ext.from }}{{ ext.params }}" class="btn btn-xs btn-default">{{ ext.text }}</a>
                            {% endif %}
                        {% endfor %}
                    </span>
                </h1>
            </div>

            <form class="form-inline" method="get" action="index.php">
                <input type="hidden" name="page" value="ventas_articulos"/>
                <div class="form-group">
                    <input type="text" name="search" class="form-control" placeholder="{{ 'search'|trans }}..." value="{{ fsc.request.query.get('search') }}" autocomplete="off"/>
                </div>
                <div class="form-group">
                    <select name="codfamilia" class="form-control">
                        <option value="">{{ 'family'|trans }}</option>
                        {% for familia in fsc.familias %}
                            <option value="{{ familia.codfamilia }}" {% if fsc.request.query.get('codfamilia') == familia.codfamilia %}selected{% endif %}>
                                {{ familia.descripcion }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <select name="codfabricante" class="form-control">
                        <option value="">{{ 'manufacturer'|trans }}</option>
                        {% for fabricante in fsc.fabricantes %}
                            <option value="{{ fabricante.codfabricante }}" {% if fsc.request.query.get('codfabricante') == fabricante.codfabricante %}selected{% endif %}>
                                {{ fabricante.nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label class="checkbox-inline">
                        <input type="checkbox" name="con_stock" value="TRUE" {% if fsc.request.query.get('con_stock') == 'TRUE' %}checked{% endif %}/>
                        {{ 'with-stock'|trans }}
                    </label>
                </div>
                <div class="form-group">
                    <label class="checkbox-inline">
                        <input type="checkbox" name="bloqueados" value="TRUE" {% if fsc.request.query.get('bloqueados') == 'TRUE' %}checked{% endif %}/>
                        {{ 'blocked'|trans }}
                    </label>
                </div>
                <button type="submit" class="btn btn-primary">
                    <span class="glyphicon glyphicon-search"></span>
                </button>
                {% if fsc.request.query.get('search') or fsc.request.query.get('codfamilia') or fsc.request.query.get('codfabricante') or fsc.request.query.get('con_stock') or fsc.request.query.get('bloqueados') %}
                <a href="{{ fsc.url() }}" class="btn btn-default">{{ 'clear'|trans }}</a>
                {% endif %}
            </form>

            <div class="table-responsive" style="margin-top: 15px;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="text-left" width="120">{{ 'reference'|trans }}</th>
                            <th class="text-left">{{ 'description'|trans }}</th>
                            <th class="text-left" width="150">{{ 'family'|trans }}</th>
                            <th class="text-left" width="150">{{ 'manufacturer'|trans }}</th>
                            <th class="text-right" width="100">{{ 'price'|trans }}</th>
                            <th class="text-right" width="80">{{ 'stock'|trans }}</th>
                            <th class="text-right" width="120">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for articulo in fsc.resultados %}
                        <tr>
                            <td>
                                <a href="{{ articulo.url() }}">{{ articulo.referencia }}</a>
                            </td>
                            <td>{{ articulo.descripcion(120) }}</td>
                            <td>
                                {% if articulo.codfamilia %}
                                    {% set fam = articulo.get_familia() %}
                                    {% if fam %}
                                        {{ fam.descripcion }}
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if articulo.codfabricante %}
                                    {% set fab = articulo.get_fabricante() %}
                                    {% if fab %}
                                        {{ fab.nombre }}
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="text-right">{{ articulo.pvp|number_format(2, ',', '.') }} €</td>
                            <td class="text-right">{{ articulo.stockfis|number_format(2, ',', '.') }}</td>
                            <td class="text-right">
                                <div class="btn-group">
                                    {% if fsc.allow_delete is defined and fsc.allow_delete %}
                                    <a class="btn btn-sm btn-danger" href="{{ articulo.url() }}&delete={{ articulo.referencia }}" title="{{ 'delete'|trans }}" onclick="return confirm('{{ 'confirm-delete'|trans }}');">
                                        <span class="glyphicon glyphicon-trash"></span>
                                    </a>
                                    {% endif %}
                                    <a class="btn btn-sm btn-primary" href="{{ articulo.url() }}" title="{{ 'show'|trans }}">
                                        <span class="glyphicon glyphicon-eye-open"></span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr class="warning">
                            <td colspan="7">{{ 'no-data'|trans }}. {{ 'new-article-hint'|trans }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if fsc.offset > 0 or fsc.hasMoreResults() %}
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    {% if fsc.offset > 0 %}
                    <li>
                        <a href="{{ fsc.getPaginationUrl(max(0, fsc.offset - 50)) }}" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    {% endif %}
                    {% if fsc.hasMoreResults() %}
                    <li>
                        <a href="{{ fsc.getPaginationUrl(fsc.offset + 50) }}" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </nav>
            {% endif %}

        </div>
    </div>
</div>

{% include 'partials/articulos/modal_nuevo_articulo.html.twig' %}

{% if fsc.can_import_export %}
{% include 'partials/articulos/modal_exportar_excel.html.twig' %}
{% include 'partials/articulos/modal_importar_excel_wizard.html.twig' %}
<script type="text/javascript">
window.catalogoArticulosExcelConfig = {
    baseUrl: {{ fsc.url()|json_encode|raw }},
    priceDecimals: {{ fsc.price_decimals }},
    defaultCodimpuesto: {{ fsc.default_codimpuesto|json_encode|raw }},
    labelNext: {{ 'next'|trans|json_encode|raw }},
    labelApply: {{ 'excel-import-apply'|trans|json_encode|raw }},
    labelClose: {{ 'close'|trans|json_encode|raw }}
};
</script>
<script src="plugins/catalogo_core/View/js/articulos-excel-import-wizard.js"></script>
{% endif %}

{{ include('footer.html.twig') }}
