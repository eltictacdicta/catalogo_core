{{ include('header.html.twig') }}

{#
 # Nested family tree for the per-list structure editor (task 3.2).
 # Depth comes from node.nivel_visual, derived from the `madre` chain; it is
 # never stored. Every node carries its own CSRF-protected POST form.
 #}
{% macro estructura_tree(nodes, fsc) %}
<ul class="familia-tree">
    {% for node in nodes %}
    <li class="familia-tree-node" data-codfamilia="{{ node.codfamilia }}" data-nivel="{{ node.nivel_visual }}">
        <div class="familia-tree-label">
            <strong>{{ node.descripcion }}</strong>
            <small class="text-muted">({{ node.codfamilia }})</small>
            <span class="label label-default">Nivel {{ node.nivel_visual }}</span>
            <span class="label {% if node.estructura.activa %}label-success{% else %}label-default{% endif %}">
                {% if node.estructura.activa %}Activa{% else %}Inactiva{% endif %}
            </span>
            <span class="text-muted">Orden {{ node.estructura.orden }}</span>
        </div>
        <form method="post" action="{{ fsc.url() }}" class="form-inline familia-estructura-form">
            {{ csrf_field() }}
            <input type="hidden" name="save_estructura" value="1" />
            <input type="hidden" name="estructura_codfamilia" value="{{ node.codfamilia }}" />
            <input type="hidden" name="estructura_codlista" value="{{ fsc.codlista }}" />
            <input class="form-control input-sm" type="text" name="estructura_capitulo"
                   value="{{ node.estructura.capitulo }}" placeholder="Capítulo" autocomplete="off" />
            <input class="form-control input-sm" type="text" name="estructura_nivel"
                   value="{{ node.estructura.nivel }}" placeholder="Nivel" autocomplete="off" />
            <input class="form-control input-sm" type="number" name="estructura_orden"
                   value="{{ node.estructura.orden }}" min="0" />
            <label class="checkbox-inline">
                <input type="checkbox" name="estructura_en_catalogo" value="1"
                       {% if node.estructura.en_catalogo %}checked{% endif %} /> Catálogo
            </label>
            <label class="checkbox-inline">
                <input type="checkbox" name="estructura_en_tarifa" value="1"
                       {% if node.estructura.en_tarifa %}checked{% endif %} /> Tarifa
            </label>
            <label class="checkbox-inline">
                <input type="checkbox" name="estructura_activa" value="1"
                       {% if node.estructura.activa %}checked{% endif %} /> Activa
            </label>
            <button class="btn btn-xs btn-primary" type="submit">Guardar</button>
        </form>
        {% if node.hijas_tree %}
            {{ _self.estructura_tree(node.hijas_tree, fsc) }}
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endmacro %}

<script type="text/javascript">
function delete_familia(url, codfamilia) {
    bootbox.confirm({
        message: '¿Realmente desea eliminar esta familia?',
        title: '<b>Atención</b>',
        callback: function (result) {
            if (result) {
                // Crear formulario POST para eliminar
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = url;

                // Agregar campo delete
                var deleteField = document.createElement('input');
                deleteField.type = 'hidden';
                deleteField.name = 'delete';
                deleteField.value = codfamilia;
                form.appendChild(deleteField);

                // Agregar token CSRF
                var csrfField = document.createElement('input');
                csrfField.type = 'hidden';
                csrfField.name = 'form_token';
                csrfField.value = document.querySelector('input[name="form_token"]').value;
                form.appendChild(csrfField);

                document.body.appendChild(form);
                form.submit();
            }
        }
    });
}
</script>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-header">
                <h1>
                    <i class="fa fa-folder-open" aria-hidden="true"></i>&nbsp;
                    {% if fsc.familia.codfamilia %}
                        {{ fsc.familia.descripcion }}
                    {% else %}
                        {{ 'family'|trans }}
                    {% endif %}
                    <a class="btn btn-xs btn-default" href="{{ fsc.url() }}" title="{{ 'reload'|trans }}">
                        <span class="glyphicon glyphicon-refresh"></span>
                    </a>
                    <span class="btn-group">
                        {% for ext in fsc.extensions %}
                            {% if ext.type == 'button' %}
                            <a href="index.php?page={{ ext.from }}{{ ext.params }}" class="btn btn-xs btn-default">{{ ext.text }}</a>
                            {% endif %}
                        {% endfor %}
                    </span>
                </h1>
            </div>
        </div>
    </div>

    {% if fsc.familia.codfamilia %}
    <div class="row">
        <div class="col-sm-12">
            <form class="form" role="form" action="{{ fsc.url() }}" method="post">
                {{ csrf_field() }}
                <input type="hidden" name="scodfamilia" value="{{ fsc.familia.codfamilia }}"/>
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">{{ 'code'|trans }}: {{ fsc.familia.codfamilia }}</h3>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ 'description'|trans }}:
                                    <input class="form-control" type="text" name="sdescripcion" value="{{ fsc.familia.descripcion }}" autocomplete="off"/>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    {{ 'parent-family'|trans }}:
                                    <select class="form-control" name="smadre">
                                        <option value="">{{ 'none'|trans }}</option>
                                        {% for madre in fsc.madres %}
                                            {% if madre.codfamilia != fsc.familia.codfamilia %}
                                            <option value="{{ madre.codfamilia }}" {% if fsc.familia.madre == madre.codfamilia %}selected{% endif %}>
                                                {{ madre.descripcion }}
                                            </option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer text-right">
                        {% if fsc.allow_delete is defined and fsc.allow_delete %}
                        <a class="btn btn-sm btn-danger pull-left" onclick="delete_familia('{{ fsc.url() }}', '{{ fsc.familia.codfamilia|url_encode }}')">
                            <span class="glyphicon glyphicon-trash"></span>&nbsp; {{ 'delete'|trans }}
                        </a>
                        {% endif %}
                        {% if fsc.family_structure %}
                        <a class="btn btn-sm btn-default" href="{{ fsc.url() }}">
                            <span class="glyphicon glyphicon-tree-deciduous"></span>&nbsp; Estructura por lista
                        </a>
                        {% endif %}
                        <button class="btn btn-sm btn-primary" type="submit" onclick="this.disabled=true;this.form.submit();">
                            <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; {{ 'save'|trans }}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">{{ 'articles'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {% if fsc.articulos|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th class="text-left">{{ 'reference'|trans }}</th>
                                    <th class="text-left">{{ 'description'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for articulo in fsc.articulos %}
                                <tr>
                                    <td><a href="{{ articulo.url() }}">{{ articulo.referencia }}</a></td>
                                    <td>{{ articulo.descripcion }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="alert alert-info">{{ 'no-articles-found'|trans }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% elseif fsc.family_structure %}
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-default" id="estructura_por_lista">
                <div class="panel-heading">
                    <h3 class="panel-title">Estructura por lista</h3>
                </div>
                <div class="panel-body">
                    <form method="get" action="{{ fsc.url() }}" class="form-inline">
                        <input type="hidden" name="page" value="ventas_familia" />
                        <input type="hidden" name="cod" value="{{ fsc.familia.codfamilia }}" />
                        <label for="codlista">Lista de precios:</label>
                        <select class="form-control input-sm" id="codlista" name="codlista">
                            {% for lista in fsc.listas_estructura %}
                            <option value="{{ lista.codlista }}" {% if lista.codlista == fsc.codlista %}selected{% endif %}>
                                {{ lista.nombre }} ({{ lista.codlista }})
                            </option>
                            {% else %}
                            <option value="">Sin listas de precio activas</option>
                            {% endfor %}
                        </select>
                        <button class="btn btn-sm btn-default" type="submit">Cambiar</button>
                    </form>

                    {% if fsc.getEstructuraTree()|length > 0 %}
                        {{ _self.estructura_tree(fsc.getEstructuraTree(), fsc) }}
                    {% else %}
                        <div class="alert alert-info">No hay familias para mostrar.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="row">
        <div class="col-sm-12">
            <div class="alert alert-warning">{{ 'family-not-found'|trans }}</div>
        </div>
    </div>
    {% endif %}
</div>

<style>
.familia-tree {
    list-style: none;
    padding-left: 18px;
    margin: 10px 0;
}
.familia-tree-node {
    margin: 8px 0;
}
.familia-tree-label {
    margin-bottom: 4px;
}
.familia-estructura-form input[type="text"],
.familia-estructura-form input[type="number"] {
    width: 110px;
}
</style>

{{ include('footer.html.twig') }}
