{{ include('header.html.twig') }}

<script type="text/javascript">
function delete_articulo(url) {
    bootbox.confirm({
        message: '¿Realmente desea eliminar este artículo?',
        title: '<b>Atención</b>',
        callback: function (result) {
            if (result) {
                window.location.href = url;
            }
        }
    });
}

function cambiar_pvp() {
    if ($("#pvp").val().search(",") >= 0) {
        $("#pvp").val($("#pvp").val().replace(",", "."));
    }
    var iva = parseFloat($("#iva").val());
    var pvp = parseFloat($("#pvp").val());
    $("#pvpi").val(pvp * (100 + iva) / 100);
    calcular_margen();
}

function cambiar_pvpi() {
    if ($("#pvpi").val().search(",") >= 0) {
        $("#pvpi").val($("#pvpi").val().replace(",", "."));
    }
    var iva = parseFloat($("#iva").val());
    var pvpi = parseFloat($("#pvpi").val());
    var pvp = (100 * pvpi) / (100 + iva);
    $("#pvp").val(pvp);
    calcular_margen();
}

function cambiar_margen() {
    if ($("#coste").val().search(",") >= 0) {
        $("#coste").val($("#coste").val().replace(",", "."));
    }
    if ($("#margen").val().search(",") >= 0) {
        $("#margen").val($("#margen").val().replace(",", "."));
    }
    var iva = parseFloat($("#iva").val());
    var coste = parseFloat($("#coste").val());
    var margen = parseFloat($("#margen").val());
    if (!isNaN(margen) && isFinite(margen)) {
        var pvp = coste * (100 + margen) / 100;
        $("#pvp").val(pvp);
        $("#pvpi").val(pvp * (100 + iva) / 100);
    }
}

function calcular_margen() {
    var coste = parseFloat($("#coste").val());
    var pvp = parseFloat($("#pvp").val());
    var margen = 0;
    if (coste > 0 && pvp !== 0) {
        margen = (pvp * 100) / coste - 100;
    }
    $("#margen").val(margen);
}

$(document).ready(function () {
    calcular_margen();
    if (window.location.hash.substring(1) == 'precios') {
        $('#tab_articulo a[href="#precios"]').tab('show');
    } else if (window.location.hash.substring(1) == 'stock') {
        $('#tab_articulo a[href="#stock"]').tab('show');
    } else if (window.location.hash.substring(1) == 'atributos') {
        $('#tab_articulo a[href="#atributos"]').tab('show');
    } else if (window.location.hash.substring(1) == 'multiidioma') {
        $('#tab_articulo a[href="#multiidioma"]').tab('show');
    } else if (window.location.hash.substring(1) == 'opcionales') {
        $('#tab_articulo a[href="#opcionales"]').tab('show');
    }
});
</script>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-header">
                <h1>
                    <i class="fa fa-cube" aria-hidden="true"></i>&nbsp;
                    {% if fsc.articulo.referencia %}
                        {{ fsc.articulo.referencia }}
                    {% else %}
                        {{ 'article'|trans }}
                    {% endif %}
                    <a class="btn btn-xs btn-default" href="{{ fsc.url() }}" title="{{ 'reload'|trans }}">
                        <span class="glyphicon glyphicon-refresh"></span>
                    </a>
                    <span class="btn-group">
                        {% for ext in fsc.extensions %}
                            {% if ext.type == 'button' %}
                            <a href="index.php?page={{ ext.from }}{{ ext.params }}" class="btn btn-xs btn-default">{{ ext.text }}</a>
                            {% endif %}
                        {% endfor %}
                    </span>
                </h1>
            </div>
        </div>
    </div>

    {% if fsc.articulo.referencia %}
    <div class="row">
        <div class="col-sm-12">
            <form class="form" role="form" action="{{ fsc.url() }}" method="post">
                {{ csrf_field() }}
                <input type="hidden" name="sreferencia" value="{{ fsc.articulo.referencia }}"/>

                <ul class="nav nav-tabs" id="tab_articulo" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#datos" aria-controls="datos" role="tab" data-toggle="tab">{{ 'data'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#precios" aria-controls="precios" role="tab" data-toggle="tab">{{ 'prices'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#stock" aria-controls="stock" role="tab" data-toggle="tab">{{ 'stock'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#multiidioma" aria-controls="multiidioma" role="tab" data-toggle="tab">{{ 'languages'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#opcionales" aria-controls="opcionales" role="tab" data-toggle="tab">{{ 'optionals'|trans }}</a>
                    </li>
                </ul>

                <div class="tab-content" style="margin-top: 15px;">
                    {# Tab: Datos #}
                    <div role="tabpanel" class="tab-pane active" id="datos">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'reference'|trans }}: {{ fsc.articulo.referencia }}</h3>
                            </div>
                            <div class="panel-body">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            {{ 'description'|trans }}:
                                            <textarea class="form-control" name="sdescripcion" rows="3" autocomplete="off">{{ fsc.articulo.descripcion }}</textarea>
                                            {% if fsc.idiomas|length > 1 %}
                                                <p class="help-block">{{ 'description-default-language-hint'|trans }}</p>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'family'|trans }}:
                                            <select class="form-control" name="scodfamilia">
                                                <option value="">{{ 'none'|trans }}</option>
                                                {% for familia in fsc.familias %}
                                                    <option value="{{ familia.codfamilia }}" {% if fsc.articulo.codfamilia == familia.codfamilia %}selected{% endif %}>
                                                        {{ familia.descripcion }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'manufacturer'|trans }}:
                                            <select class="form-control" name="scodfabricante">
                                                <option value="">{{ 'none'|trans }}</option>
                                                {% for fabricante in fsc.fabricantes %}
                                                    <option value="{{ fabricante.codfabricante }}" {% if fsc.articulo.codfabricante == fabricante.codfabricante %}selected{% endif %}>
                                                        {{ fabricante.nombre }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'tax'|trans }}:
                                            <select class="form-control" name="scodimpuesto" id="codimpuesto" onchange="cambiar_pvp()">
                                                <option value="">{{ 'none'|trans }}</option>
                                                {% for impuesto in fsc.impuestos %}
                                                    <option value="{{ impuesto.codimpuesto }}" {% if fsc.articulo.codimpuesto == impuesto.codimpuesto %}selected{% endif %} data-iva="{{ impuesto.iva }}">
                                                        {{ impuesto.descripcion }} ({{ impuesto.iva }}%)
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ 'barcode'|trans }}:
                                            <input class="form-control" type="text" name="scodbarras" value="{{ fsc.articulo.codbarras }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ 'equivalence-code'|trans }}:
                                            <input class="form-control" type="text" name="sequivalencia" value="{{ fsc.articulo.equivalencia }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ 'part-number'|trans }}:
                                            <input class="form-control" type="text" name="spartnumber" value="{{ fsc.articulo.partnumber }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            {{ 'observations'|trans }}:
                                            <textarea class="form-control" name="sobservaciones" rows="2" autocomplete="off">{{ fsc.articulo.observaciones }}</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="ssevende" value="TRUE" {% if fsc.articulo.sevende %}checked{% endif %}/>
                                                {{ 'can-sell'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="ssecompra" value="TRUE" {% if fsc.articulo.secompra %}checked{% endif %}/>
                                                {{ 'can-buy'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="spublico" value="TRUE" {% if fsc.articulo.publico %}checked{% endif %}/>
                                                {{ 'public'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="sbloqueado" value="TRUE" {% if fsc.articulo.bloqueado %}checked{% endif %}/>
                                                {{ 'blocked'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Tab: Precios #}
                    <div role="tabpanel" class="tab-pane" id="precios">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'prices'|trans }}</h3>
                            </div>
                            <div class="panel-body">
                                <input type="hidden" id="iva" value="{{ fsc.articulo.get_iva() }}"/>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'cost-price'|trans }}:
                                            <input class="form-control" type="text" id="coste" value="{{ fsc.articulo.preciocoste()|number_format(2, ',', '.') }}" readonly="readonly"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'sale-price'|trans }} ({{ 'without-tax'|trans }}):
                                            <input class="form-control" type="text" id="pvp" name="spvp" value="{{ fsc.articulo.pvp|number_format(2, ',', '.') }}" oninput="cambiar_pvp()" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'sale-price'|trans }} ({{ 'with-tax'|trans }}):
                                            <input class="form-control" type="text" id="pvpi" oninput="cambiar_pvpi()" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'margin'|trans }} (%):
                                            <input class="form-control" type="text" id="margen" oninput="cambiar_margen()" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Tab: Stock #}
                    <div role="tabpanel" class="tab-pane" id="stock">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'stock'|trans }}</h3>
                            </div>
                            <div class="panel-body">
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'physical-stock'|trans }}:
                                            <input class="form-control" type="text" name="sstockfis" value="{{ fsc.articulo.stockfis|number_format(2, ',', '.') }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'minimum-stock'|trans }}:
                                            <input class="form-control" type="text" name="sstockmin" value="{{ fsc.articulo.stockmin|number_format(2, ',', '.') }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'maximum-stock'|trans }}:
                                            <input class="form-control" type="text" name="sstockmax" value="{{ fsc.articulo.stockmax|number_format(2, ',', '.') }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="snostock" value="TRUE" {% if fsc.articulo.nostock %}checked{% endif %}/>
                                                {{ 'no-stock-control'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% include 'partials/articulos/tab_multiidioma.html.twig' %}
                    {% include 'partials/articulos/tab_opcionales.html.twig' %}
                </div>

                <div class="panel-footer text-right" style="margin-top: 15px;">
                    {% if fsc.allow_delete is defined and fsc.allow_delete %}
                    <a class="btn btn-sm btn-danger pull-left" onclick="delete_articulo('{{ fsc.url() }}&delete={{ fsc.articulo.referencia }}')">
                        <span class="glyphicon glyphicon-trash"></span>&nbsp; {{ 'delete'|trans }}
                    </a>
                    {% endif %}
                    <button class="btn btn-sm btn-primary" type="submit" onclick="this.disabled=true;this.form.submit();">
                        <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; {{ 'save'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
    {% else %}
    <div class="row">
        <div class="col-sm-12">
            <div class="alert alert-warning">{{ 'article-not-found'|trans }}</div>
        </div>
    </div>
    {% endif %}
</div>

{% if fsc.articulo.referencia %}
<script type="text/javascript">
(function ($) {
    'use strict';

    var labels = {
        yes: {{ 'optional-required-tpv-yes'|trans|json_encode|raw }},
        no: {{ 'optional-required-tpv-no'|trans|json_encode|raw }}
    };

    var i18n = {
        genericError: {{ 'optional-ajax-error'|trans|default('No se pudo completar la operación.')|json_encode|raw }},
        confirmRemoveGrupo: {{ 'remove-optional-group-from-article-confirm'|trans|default('¿Quitar este grupo del artículo?')|json_encode|raw }},
        confirmRemoveOpcional: {{ 'remove-optional-from-article-confirm'|trans|default('¿Quitar este opcional del artículo?')|json_encode|raw }},
        selectGrupo: {{ 'optional-select-group'|trans|default('Selecciona un grupo.')|json_encode|raw }},
        selectOpcional: {{ 'optional-select-optional'|trans|default('Selecciona un opcional.')|json_encode|raw }},
        attention: {{ 'attention'|trans|default('Atención')|json_encode|raw }}
    };

    function getPanel() {
        return $('#opcionales');
    }

    function getArticuloRef() {
        return getPanel().data('articulo-ref');
    }

    function getArticuloUrl() {
        var ref = getArticuloRef();
        var fromData = getPanel().data('articulo-url');

        if (fromData && String(fromData).indexOf('ref=') >= 0) {
            return fromData;
        }

        if (ref) {
            return 'index.php?page=ventas_articulo&ref=' + encodeURIComponent(ref);
        }

        return fromData || 'index.php?page=ventas_articulo';
    }

    function buildOpcionalesPartialUrl() {
        var ref = getArticuloRef();
        if (!ref) {
            return null;
        }

        return 'index.php?page=ventas_articulo&ref=' + encodeURIComponent(ref) + '&partial=opcionales&ajax=1';
    }

    function showMessage(message) {
        if (window.bootbox) {
            bootbox.alert(message);
            return;
        }

        window.alert(message);
    }

    function securePost(payload, callbacks) {
        var url = getArticuloUrl();
        callbacks = callbacks || {};

        var onSuccess = callbacks.onSuccess || function () {};
        var onError = callbacks.onError || function () {
            showMessage(i18n.genericError);
        };

        if (window.FSAjaxLoader && typeof window.FSAjaxLoader.securePost === 'function') {
            window.FSAjaxLoader.securePost(url, payload, {
                dataType: 'json',
                onSuccess: onSuccess,
                onError: onError
            });
            return;
        }

        var csrfToken = $('meta[name="csrf-token"]').attr('content') || '';
        payload._csrf_token = csrfToken;
        payload._token = csrfToken;

        $.ajax({
            url: url,
            method: 'POST',
            data: payload,
            dataType: 'json',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        }).done(onSuccess).fail(onError);
    }

    function parseOpcionalesPanel(html) {
        if (!html) {
            return $();
        }

        var $parsed = $($.parseHTML(html, document, false));
        var $panel = $parsed.filter('#opcionales').first();
        if (!$panel.length) {
            $panel = $parsed.find('#opcionales').first();
        }

        return $panel;
    }

    function applyOpcionalesHtml(html) {
        var $current = getPanel();
        if (!$current.length) {
            return false;
        }

        var $newPanel = parseOpcionalesPanel(html);
        if (!$newPanel.length) {
            return false;
        }

        var keepActive = $current.hasClass('active');
        if (keepActive) {
            $newPanel.addClass('active');
        }

        $current.replaceWith($newPanel);

        if (keepActive) {
            $('#tab_articulo li').removeClass('active');
            $('#tab_articulo a[href="#opcionales"]').parent('li').addClass('active');
        }

        return true;
    }

    function reloadOpcionalesTab() {
        var reloadUrl = buildOpcionalesPartialUrl();
        if (!reloadUrl) {
            showMessage(i18n.genericError);
            return;
        }

        $.ajax({
            url: reloadUrl,
            method: 'GET',
            dataType: 'html',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        }).done(function (html) {
            if (!applyOpcionalesHtml(html)) {
                showMessage(i18n.genericError);
            }
        }).fail(function (xhr) {
            var message = i18n.genericError;
            if (xhr.responseJSON && xhr.responseJSON.message) {
                message = xhr.responseJSON.message;
            }
            showMessage(message);
        });
    }

    function handleJsonResponse(response, onOk) {
        if (response && response.ok) {
            if (typeof onOk === 'function') {
                onOk(response);
                return;
            }

            if (response.html && applyOpcionalesHtml(response.html)) {
                return;
            }

            reloadOpcionalesTab();
            return;
        }

        showMessage((response && response.message) ? response.message : i18n.genericError);
    }

    function updateObligatorioToggle($btn, obligatorio) {
        var $label = $btn.find('.label');

        $btn.attr('data-obligatorio', obligatorio ? '1' : '0');
        $btn.toggleClass('btn-warning', obligatorio);
        $btn.toggleClass('btn-default', !obligatorio);
        $label.toggleClass('label-warning', obligatorio);
        $label.toggleClass('label-default', !obligatorio);
        $label.text(obligatorio ? labels.yes : labels.no);
    }

    function confirmAction(message, callback) {
        if (window.bootbox) {
            bootbox.confirm({
                message: message,
                title: '<b>' + i18n.attention + '</b>',
                callback: function (result) {
                    if (result) {
                        callback();
                    }
                }
            });
            return;
        }

        if (window.confirm(message)) {
            callback();
        }
    }

    $(document).on('click', '#opcionales .js-toggle-obligatorio-tpv', function (event) {
        event.preventDefault();

        var $btn = $(this);
        if ($btn.prop('disabled')) {
            return;
        }

        var type = $btn.data('type');
        var id = parseInt($btn.data('id'), 10);
        var current = $btn.attr('data-obligatorio') === '1';
        var next = !current;

        var payload = {
            sreferencia: getArticuloRef(),
            obligatorio: next ? '1' : '0'
        };

        if (type === 'grupo') {
            payload.toggle_obligatorio_grupo = '1';
            payload.id_grupo = id;
        } else {
            payload.toggle_obligatorio_opcional = '1';
            payload.id_opcional = id;
        }

        $btn.prop('disabled', true);

        securePost(payload, {
            onSuccess: function (response) {
                if (response && response.ok) {
                    updateObligatorioToggle($btn, !!response.obligatorio);
                } else {
                    showMessage((response && response.message) ? response.message : i18n.genericError);
                }
                $btn.prop('disabled', false);
            },
            onError: function () {
                showMessage(i18n.genericError);
                $btn.prop('disabled', false);
            }
        });
    });

    $(document).on('click', '#opcionales .js-add-grupo-submit', function (event) {
        event.preventDefault();

        var $form = $(this).closest('.js-add-grupo-form');
        var $submit = $form.find('.js-add-grupo-submit');
        var idGrupo = parseInt($form.find('[name="id_grupo"]').val(), 10);

        if (!idGrupo) {
            showMessage(i18n.selectGrupo);
            return;
        }

        $submit.prop('disabled', true);

        securePost({
            add_grupo_articulo: '1',
            sreferencia: getArticuloRef(),
            id_grupo: idGrupo,
            obligatorio: $form.find('[name="obligatorio"]').is(':checked') ? '1' : '0'
        }, {
            onSuccess: function (response) {
                handleJsonResponse(response);
                $submit.prop('disabled', false);
            },
            onError: function () {
                showMessage(i18n.genericError);
                $submit.prop('disabled', false);
            }
        });
    });

    $(document).on('click', '#opcionales .js-add-opcional-submit', function (event) {
        event.preventDefault();

        var $form = $(this).closest('.js-add-opcional-form');
        var $submit = $form.find('.js-add-opcional-submit');
        var idOpcional = parseInt($form.find('[name="id_opcional"]').val(), 10);

        if (!idOpcional) {
            showMessage(i18n.selectOpcional);
            return;
        }

        $submit.prop('disabled', true);

        securePost({
            add_opcional_articulo: '1',
            sreferencia: getArticuloRef(),
            id_opcional: idOpcional,
            obligatorio: $form.find('[name="obligatorio"]').is(':checked') ? '1' : '0'
        }, {
            onSuccess: function (response) {
                handleJsonResponse(response);
                $submit.prop('disabled', false);
            },
            onError: function () {
                showMessage(i18n.genericError);
                $submit.prop('disabled', false);
            }
        });
    });

    $(document).on('click', '#opcionales .js-remove-grupo-articulo', function (event) {
        event.preventDefault();

        var $btn = $(this);
        var idGrupo = parseInt($btn.data('id'), 10);

        confirmAction(i18n.confirmRemoveGrupo, function () {
            $btn.prop('disabled', true);

            securePost({
                remove_grupo_articulo: '1',
                sreferencia: getArticuloRef(),
                id_grupo: idGrupo
            }, {
                onSuccess: function (response) {
                    handleJsonResponse(response);
                },
                onError: function () {
                    showMessage(i18n.genericError);
                    $btn.prop('disabled', false);
                }
            });
        });
    });

    $(document).on('click', '#opcionales .js-remove-opcional-articulo', function (event) {
        event.preventDefault();

        var $btn = $(this);
        var idOpcional = parseInt($btn.data('id'), 10);

        confirmAction(i18n.confirmRemoveOpcional, function () {
            $btn.prop('disabled', true);

            securePost({
                remove_opcional_articulo: '1',
                sreferencia: getArticuloRef(),
                id_opcional: idOpcional
            }, {
                onSuccess: function (response) {
                    handleJsonResponse(response);
                },
                onError: function () {
                    showMessage(i18n.genericError);
                    $btn.prop('disabled', false);
                }
            });
        });
    });
})(jQuery);
</script>
{% endif %}

