{{ include('header.html.twig') }}
{% import 'Macro/Htmx.html.twig' as htmx %}
{% import 'Macro/Alpine.html.twig' as alpine %}

<div class="container-fluid" x-data="articuloDetalle"
     x-on:tarifarioMessage.window="notify($event.detail.ok, $event.detail.message)">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-header">
                <h1>
                    <i class="fa fa-cube" aria-hidden="true"></i>&nbsp;
                    {% if fsc.articulo.referencia %}
                        {{ fsc.articulo.referencia }}
                    {% else %}
                        {{ 'article'|trans }}
                    {% endif %}
                    <a class="btn btn-xs btn-default" href="{{ fsc.url() }}" title="{{ 'reload'|trans }}">
                        <span class="glyphicon glyphicon-refresh"></span>
                    </a>
                    <span class="btn-group">
                        {% for ext in fsc.extensions %}
                            {% if ext.type == 'button' %}
                            <a href="index.php?page={{ ext.from }}{{ ext.params }}" class="btn btn-xs btn-default">{{ ext.text }}</a>
                            {% endif %}
                        {% endfor %}
                    </span>
                </h1>
            </div>
            <div class="callout" x-show="message" x-cloak :class="messageClass" x-text="message"></div>
        </div>
    </div>

    {% if fsc.articulo.referencia %}
    <div class="row">
        <div class="col-sm-12">
            <form class="form" role="form" action="{{ fsc.url() }}" method="post">
                {{ csrf_field() }}
                <input type="hidden" name="sreferencia" value="{{ fsc.articulo.referencia }}"/>

                <ul class="nav nav-tabs" id="tab_articulo" role="tablist"
                    x-data="articuloTabs" x-init="activarDesdeHash()">
                    <li role="presentation" class="active">
                        <a href="#datos" aria-controls="datos" role="tab" data-toggle="tab" x-on:click.prevent="activar('datos')">{{ 'data'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#precios" aria-controls="precios" role="tab" data-toggle="tab" x-on:click.prevent="activar('precios')">{{ 'prices'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#stock" aria-controls="stock" role="tab" data-toggle="tab" x-on:click.prevent="activar('stock')">{{ 'stock'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#multiidioma" aria-controls="multiidioma" role="tab" data-toggle="tab" x-on:click.prevent="activar('multiidioma')">{{ 'languages'|trans }}</a>
                    </li>
                    <li role="presentation">
                        <a href="#opcionales" aria-controls="opcionales" role="tab" data-toggle="tab" x-on:click.prevent="activar('opcionales')">{{ 'optionals'|trans }}</a>
                    </li>
                    {{- render_hook('ventas_articulo_tabs_after', {'fsc': fsc, 'user': user, 'empresa': empresa, 'i18n': i18n, 'caracteristicas': fsc.caracteristicas_context()}) -}}
                </ul>

                <div class="tab-content" style="margin-top: 15px;">
                    {# Tab: Datos #}
                    <div role="tabpanel" class="tab-pane active" id="datos">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'reference'|trans }}: {{ fsc.articulo.referencia }}</h3>
                            </div>
                            <div class="panel-body">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            {{ 'description'|trans }}:
                                            <textarea class="form-control" name="sdescripcion" rows="3" autocomplete="off">{{ fsc.articulo.descripcion }}</textarea>
                                            {% if fsc.idiomas|length > 1 %}
                                                <p class="help-block">{{ 'description-default-language-hint'|trans }}</p>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'reference'|trans }}:
                                            <input class="form-control" type="text" name="snueva_referencia" value="{{ fsc.articulo.referencia }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'family'|trans }}:
                                            <select class="form-control" name="scodfamilia">
                                                <option value="">{{ 'none'|trans }}</option>
                                                {% for familia in fsc.familias %}
                                                    <option value="{{ familia.codfamilia }}" {% if fsc.articulo.codfamilia == familia.codfamilia %}selected{% endif %}>
                                                        {{ familia.descripcion }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'manufacturer'|trans }}:
                                            <select class="form-control" name="scodfabricante">
                                                <option value="">{{ 'none'|trans }}</option>
                                                {% for fabricante in fsc.fabricantes %}
                                                    <option value="{{ fabricante.codfabricante }}" {% if fsc.articulo.codfabricante == fabricante.codfabricante %}selected{% endif %}>
                                                        {{ fabricante.nombre }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'tax'|trans }}:
                                            <select class="form-control" name="scodimpuesto" id="codimpuesto">
                                                <option value="">{{ 'none'|trans }}</option>
                                                {% for impuesto in fsc.impuestos %}
                                                    <option value="{{ impuesto.codimpuesto }}" {% if fsc.articulo.codimpuesto == impuesto.codimpuesto %}selected{% endif %} data-iva="{{ impuesto.iva }}">
                                                        {{ impuesto.descripcion }} ({{ impuesto.iva }}%)
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ 'barcode'|trans }}:
                                            <input class="form-control" type="text" name="scodbarras" value="{{ fsc.articulo.codbarras }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ 'equivalence-code'|trans }}:
                                            <input class="form-control" type="text" name="sequivalencia" value="{{ fsc.articulo.equivalencia }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            {{ 'part-number'|trans }}:
                                            <input class="form-control" type="text" name="spartnumber" value="{{ fsc.articulo.partnumber }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            {{ 'observations'|trans }}:
                                            <textarea class="form-control" name="sobservaciones" rows="2" autocomplete="off">{{ fsc.articulo.observaciones }}</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="ssevende" value="TRUE" {% if fsc.articulo.sevende %}checked{% endif %}/>
                                                {{ 'can-sell'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="ssecompra" value="TRUE" {% if fsc.articulo.secompra %}checked{% endif %}/>
                                                {{ 'can-buy'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="spublico" value="TRUE" {% if fsc.articulo.publico %}checked{% endif %}/>
                                                {{ 'public'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="sbloqueado" value="TRUE" {% if fsc.articulo.bloqueado %}checked{% endif %}/>
                                                {{ 'blocked'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Imágenes del artículo (absorbido de tarif_articulo_edit, AD-W2-7) #}
                        <div class="panel panel-default" x-data="articuloImagenes">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'images'|trans }}</h3>
                            </div>
                            <div class="panel-body" id="articulo-imagenes">
                                {% if fsc.imagenes is iterable %}
                                    {% for imagen in fsc.imagenes %}
                                        <div class="thumbnail" style="display: inline-block; margin-right: 10px;">
                                            <img src="{{ imagen.url_imagen() }}" alt="{{ imagen.nombre_archivo }}" style="max-height: 90px;"/>
                                            <div class="caption text-center">
                                                <button type="button" class="btn btn-xs btn-default"
                                                        hx-post="{{ fsc.url() }}"
                                                        hx-vals='{"destacar_imagen": "{{ imagen.id }}", "_csrf_token": "{{ csrf_token() }}"}'
                                                        hx-target="#articulo-imagenes" hx-swap="outerHTML"
                                                        x-on:click="destacar()">{{ 'feature'|trans }}</button>
                                                <button type="button" class="btn btn-xs btn-danger"
                                                        hx-post="{{ fsc.url() }}"
                                                        hx-vals='{"delete_imagen": "{{ imagen.id }}", "_csrf_token": "{{ csrf_token() }}"}'
                                                        hx-target="#articulo-imagenes" hx-swap="outerHTML"
                                                        hx-confirm="{{ 'delete'|trans }}"
                                                        x-on:click="eliminar()">{{ 'delete'|trans }}</button>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                                {% if fsc.allow_delete is defined and fsc.allow_delete %}
                                <form hx-post="{{ fsc.url() }}" hx-target="#articulo-imagenes" hx-swap="outerHTML" hx-encoding="multipart/form-data">
                                    {{ csrf_field() }}
                                    <input type="hidden" name="upload_imagen" value="1"/>
                                    <input type="hidden" name="sreferencia" value="{{ fsc.articulo.referencia }}"/>
                                    <input type="file" name="imagen"/>
                                    <button class="btn btn-xs btn-primary" type="submit">{{ 'upload'|trans }}</button>
                                </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Tab: Precios #}
                    <div role="tabpanel" class="tab-pane" id="precios">
                        <div class="panel panel-default" x-data="articuloPrecios">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'prices'|trans }}</h3>
                            </div>
                            <div class="panel-body">
                                <input type="hidden" id="iva" value="{{ fsc.articulo.get_iva() }}" x-ref="iva"/>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'cost-price'|trans }}:
                                            <input class="form-control" type="text" id="coste" value="{{ fsc.articulo.preciocoste()|number_format(2, ',', '.') }}" readonly="readonly" x-ref="coste"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'sale-price'|trans }} ({{ 'without-tax'|trans }}):
                                            <input class="form-control" type="text" id="pvp" name="spvp" value="{{ fsc.articulo.pvp|number_format(2, ',', '.') }}" x-model="pvp" x-on:input="recalcularPvp()" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'sale-price'|trans }} ({{ 'with-tax'|trans }}):
                                            <input class="form-control" type="text" id="pvpi" x-model="pvpi" x-on:input="recalcularPvpi()" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            {{ 'margin'|trans }} (%):
                                            <input class="form-control" type="text" id="margen" x-model="margen" x-on:input="recalcularMargen()" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Tab: Stock #}
                    <div role="tabpanel" class="tab-pane" id="stock">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3 class="panel-title">{{ 'stock'|trans }}</h3>
                            </div>
                            <div class="panel-body">
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'physical-stock'|trans }}:
                                            <input class="form-control" type="text" name="sstockfis" value="{{ fsc.articulo.stockfis|number_format(2, ',', '.') }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'minimum-stock'|trans }}:
                                            <input class="form-control" type="text" name="sstockmin" value="{{ fsc.articulo.stockmin|number_format(2, ',', '.') }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            {{ 'maximum-stock'|trans }}:
                                            <input class="form-control" type="text" name="sstockmax" value="{{ fsc.articulo.stockmax|number_format(2, ',', '.') }}" autocomplete="off"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="snostock" value="TRUE" {% if fsc.articulo.nostock %}checked{% endif %}/>
                                                {{ 'no-stock-control'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% include 'partials/articulos/tab_multiidioma.html.twig' %}
                    {% include 'partials/articulos/tab_opcionales.html.twig' %}
                    {{- render_hook('ventas_articulo_tab_pane_after', {'fsc': fsc, 'user': user, 'empresa': empresa, 'i18n': i18n, 'caracteristicas': fsc.caracteristicas_context()}) -}}
                </div>

                <div class="panel-footer text-right" style="margin-top: 15px;">
                    {% if fsc.allow_delete is defined and fsc.allow_delete %}
                    <button class="btn btn-sm btn-danger pull-left" type="submit" name="eliminar_articulo" value="1"
                            formaction="{{ fsc.url() }}" hx-post="{{ fsc.url() }}" hx-target="body"
                            hx-confirm="{{ 'delete'|trans }}">
                        <span class="glyphicon glyphicon-trash"></span>&nbsp; {{ 'delete'|trans }}
                    </button>
                    {% endif %}
                    <button class="btn btn-sm btn-primary" type="submit">
                        <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; {{ 'save'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
    {% else %}
    <div class="row">
        <div class="col-sm-12">
            <div class="alert alert-warning">{{ 'article-not-found'|trans }}</div>
        </div>
    </div>
    {% endif %}
</div>

<style>
   [x-cloak] {
      display: none !important;
   }
</style>

{% if fsc.articulo.referencia %}
<script {{ csp_nonce_attr() }}>
// Host owns the htmx 4 + Alpine CSP boot (AD-W2-3): the injected Tarifas pane
// no longer boots, so every component is registered here behind alpine:init.
document.addEventListener('alpine:init', function () {
    Alpine.data('articuloDetalle', function () {
        return {
            message: '',
            messageClass: 'callout-success',
            notify: function (ok, text) {
                this.message = text || '';
                this.messageClass = ok ? 'callout-success' : 'callout-danger';
            }
        };
    });

    Alpine.data('articuloTabs', function () {
        return {
            activar: function (id) {
                var list = document.getElementById('tab_articulo');
                if (!list) { return; }
                Array.prototype.slice.call(list.querySelectorAll('li')).forEach(function (li) {
                    li.classList.remove('active');
                });
                var panes = document.querySelectorAll('.tab-content > .tab-pane');
                Array.prototype.slice.call(panes).forEach(function (pane) {
                    pane.classList.remove('active');
                });
                var link = list.querySelector('a[href="#' + id + '"]');
                if (link && link.parentNode) { link.parentNode.classList.add('active'); }
                var pane = document.getElementById(id);
                if (pane) { pane.classList.add('active'); }
            },
            activarDesdeHash: function () {
                var hash = window.location.hash.substring(1);
                if (hash !== '') { this.activar(hash); }
            }
        };
    });

    Alpine.data('articuloPrecios', function () {
        return {
            iva: 0,
            pvp: 0,
            pvpi: 0,
            margen: 0,
            init: function () {
                var iva = document.getElementById('iva');
                var pvpInput = document.getElementById('pvp');
                this.iva = iva ? parseFloat(iva.value) || 0 : 0;
                // Seed from the server-rendered sale price: x-model would
                // otherwise push the hard-coded 0 into the input and drop the
                // saved price on submit.
                if (pvpInput && pvpInput.value !== '') {
                    this.pvp = parseFloat(String(pvpInput.value).replace(',', '.')) || 0;
                }
                this.recalcularPvp();
            },
            recalcularPvp: function () {
                this.pvp = parseFloat(String(this.pvp).replace(',', '.')) || 0;
                this.pvpi = this.pvp * (100 + this.iva) / 100;
                this.recalcularMargen();
            },
            recalcularPvpi: function () {
                this.pvpi = parseFloat(String(this.pvpi).replace(',', '.')) || 0;
                this.pvp = (100 * this.pvpi) / (100 + this.iva);
                this.recalcularMargen();
            },
            recalcularMargen: function () {
                var coste = document.getElementById('coste');
                var costeValue = coste ? parseFloat(String(coste.value).replace(',', '.')) || 0 : 0;
                this.margen = (costeValue > 0 && this.pvp !== 0) ? (this.pvp * 100) / costeValue - 100 : 0;
            }
        };
    });

    Alpine.data('articuloImagenes', function () {
        return {
            destacar: function () {
                // The hx-post already performs the swap; this only reflects intent.
            },
            eliminar: function () {
                // The hx-post already performs the swap; this only reflects intent.
            }
        };
    });

    Alpine.data('articuloOpcionales', function () {
        return {
            notify: function (ok, text) {
                window.dispatchEvent(new CustomEvent('tarifarioMessage', {
                    detail: { ok: ok, message: text }
                }));
            }
        };
    });
});
</script>
{% endif %}

{{ htmx.boot({'allowScriptTags': false}) }}
{{ alpine.boot() }}

{{ include('footer.html.twig') }}
