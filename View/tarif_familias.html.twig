{#
 # Gestión de Familias del Tarifario
 # HTMX-first view — fragment endpoints, row swaps, hx-confirm dialogs
 #}
{% import 'Macro/TarifarioComponents.html.twig' as tarif %}
{% import 'Macro/HtmxCrud.html.twig' as crud %}
{% import 'Macro/Htmx.html.twig' as htmx %}
{% import 'Macro/Alpine.html.twig' as alpine %}

{% include 'header.html.twig' %}

{# htmx core boot (htmx.min.js) — htmx-crud.js expects window.htmx to be present #}
{{ htmx.boot() }}
{# HTMX CRUD boot — loads Sortable, fs-dialogs, htmx-crud.js #}
{{ crud.boot({
   sortable: {
      tbody: '#familias-tbody',
      url: fsc.url() ~ '&codtarifa=' ~ fsc.codtarifa ~ '&action=reorder',
      handle: '.drag-handle',
      guard: 'same-madre',
      saveBar: 'familias'
   }
}) }}

{# Styles #}
{{ tarif.styles_common() }}
<style>
   [x-cloak] {
      display: none !important;
   }
   .familia-alpine-modal {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 1050;
      overflow-y: auto;
      outline: 0;
   }
   .familia-alpine-backdrop {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 1040;
      background-color: #000;
      opacity: 0.5;
   }
   .familia-row.sortable-ghost {
      opacity: 0.4;
   }
   .drag-handle {
      color: #ccc;
      cursor: move;
      padding: 5px;
   }
   .drag-handle:hover {
      color: #666;
   }
   .btn-familia-action {
      padding: 2px 8px;
      font-size: 12px;
   }
   .table-familias {
      margin-bottom: 0;
   }
   .table-familias > tbody > tr > td {
      vertical-align: middle;
      padding: 10px 8px;
   }
   .save-order-bar {
      background-color: #fff3cd;
      border: 1px solid #ffc107;
      padding: 10px 15px;
      margin-bottom: 15px;
      border-radius: 4px;
      display: none;
   }
   .save-order-bar.show {
      display: flex;
      justify-content: space-between;
      align-items: center;
   }
   .btn-level {
      padding: 2px 6px;
      font-size: 11px;
      margin-right: 2px;
   }
   .btn-level:disabled {
      opacity: 0.3;
      cursor: not-allowed;
   }
   .level-actions {
      white-space: nowrap;
   }
</style>

<script type="text/javascript">
   var soloActivas = {% if fsc.b_solo_activas %}true{% else %}false{% endif %};
   
   function cambiarTarifa() {
      var nuevaTarifa = document.getElementById('select_tarifa').value;
      window.location.href = '{{ fsc.url() }}&codtarifa=' + encodeURIComponent(nuevaTarifa) + '&b_solo_activas=' + (soloActivas ? 'TRUE' : 'FALSE');
   }
</script>

{# Toolbar #}
{% set extra_buttons = [] %}
{% if fsc.codtarifa %}
   {% set extra_buttons = [{
      'onclick': "document.dispatchEvent(new CustomEvent('familias-add-open', {bubbles: true}))",
      'class': 'btn-success',
      'icon': 'glyphicon glyphicon-plus',
      'label': 'Añadir familia'
   }] %}
{% endif %}

{% set extra_buttons = extra_buttons|merge([
   {'onclick': "document.dispatchEvent(new CustomEvent('familias-export-open', {bubbles: true}))", 'icon': 'fa fa-file-excel-o', 'label': 'Exportar Excel', 'class': 'btn-success'},
   {'onclick': "document.dispatchEvent(new CustomEvent('familias-import-open', {bubbles: true}))", 'icon': 'fa fa-file-excel-o', 'label': 'Importar Excel', 'class': 'btn-info'},
   {'onclick': 'descargarPlantillaExcel()', 'icon': 'fa fa-file-o', 'label': 'Plantilla', 'class': 'btn-default'}
]) %}

{% set right_filter = {} %}
{% if fsc.b_solo_activas %}
   {% set right_filter = {
      'href': fsc.url() ~ '&codtarifa=' ~ fsc.codtarifa ~ '&b_solo_activas=FALSE',
      'class': 'btn-info',
      'icon': 'fa fa-check-circle',
      'label': 'Solo activas',
      'title': 'Mostrar todas las familias'
   } %}
{% else %}
   {% set right_filter = {
      'href': fsc.url() ~ '&codtarifa=' ~ fsc.codtarifa ~ '&b_solo_activas=TRUE',
      'class': 'btn-default',
      'icon': 'fa fa-circle-o',
      'label': 'Todas',
      'title': 'Mostrar solo familias activas'
   } %}
{% endif %}

{{ tarif.toolbar(fsc, {
   'show_catalogo_link': true,
   'extra_buttons': extra_buttons,
   'right_buttons': [right_filter]
}) }}

{# Save order bar #}
<div class="container-fluid">
   {{ crud.saveBar('familias', {
      saveUrl: fsc.url() ~ '&codtarifa=' ~ fsc.codtarifa ~ '&action=reorder'
   }) }}
</div>

{# Main content #}
{% if not fsc.codtarifa %}
<div class="container-fluid">
   <div class="alert alert-warning">
      <i class="fa fa-exclamation-triangle"></i>
      No hay tarifas definidas. <a href="index.php?page=tarif_tarifas">Crear una tarifa</a> primero.
   </div>
</div>
{% else %}
<div class="container-fluid">
   <div class="panel panel-default">
      <div class="panel-heading">
         <h4 class="panel-title">
            <i class="fa fa-folder-open-o"></i> Familias de: <strong>{{ fsc.get_tarifa_actual().nombre }}</strong>
            <small class="text-muted">&nbsp;- Arrastra para reordenar</small>
         </h4>
      </div>
      <div class="table-responsive">
         <table class="table table-familias">
            <thead>
               <tr>
                  <th style="width: 40px;"></th>
                  <th style="width: 80px;">Capítulo</th>
                  <th>Nombre</th>
                  <th style="width: 80px;" class="text-center">Nivel</th>
                  <th style="width: 70px;" class="text-center" title="Artículos">Art.</th>
                  <th style="width: 60px;" class="text-center" title="En catálogo">Cat.</th>
                  <th style="width: 60px;" class="text-center" title="En tarifa (exportación)">Tar.</th>
                  <th style="width: 60px;" class="text-center" title="Activa">Act.</th>
                  <th style="width: 100px;" class="text-right">Acciones</th>
               </tr>
            </thead>
            <tbody id="familias-tbody">
               {% for fam in fsc.get_familias_flat() %}
               {% include 'partials/familias/familia_row.html.twig' with {row: fam, fsc: fsc} %}
               {% else %}
               <tr class="warning">
                  <td colspan="9">
                  No hay familias en esta tarifa.
                  <a href="#" data-toggle="modal" data-target="#modal_add_familia">Añadir familia</a>
                  o <a href="index.php?page=ventas_familia">Crear familias primero</a> en el catálogo.
                  </td>
               </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   </div>
</div>
{% endif %}

{# Modal Editar Familia — HTMX-driven: the row's Editar links fetch this modal
   as a fragment into the container below. The same partial renders inline here
   for the no-JS fallback when the page loads with ?edit=CODE. #}
<div id="familia-edit-container"></div>
{% if fsc.editing_familia %}
{% include 'partials/familias/edit_modal.html.twig' %}
{% endif %}

{# Modal Añadir Familia — Alpine (CSP build): opened via the familias-add-open
   event from the toolbar button; closed by fs:modal-close (server-sent). #}
{% if fsc.codtarifa %}
<div x-data="familiaAddModal" x-cloak>
   <div class="familia-alpine-backdrop" x-show="open" @click="close()"></div>
   <div class="familia-alpine-modal" id="modal_add_familia" x-show="open" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
         <div class="modal-content">
            <div class="modal-header">
               <button type="button" class="close" @click="close()">&times;</button>
               <h4 class="modal-title">
                  <i class="fa fa-plus"></i> Añadir familia a la tarifa
               </h4>
            </div>
            <form class="form-horizontal" role="form" action="{{ fsc.url() }}&codtarifa={{ fsc.codtarifa }}" method="post"
                  hx-post="{{ fsc.url() ~ '&codtarifa=' ~ fsc.codtarifa }}"
                  hx-target="#familias-tbody" hx-swap="innerHTML"
                  data-fs-csrf-strip>
               {{ csrf_field() }}
               <input type="hidden" name="add_familia" value="1"/>
            <div class="modal-body">
               <div class="form-group">
                  <label class="col-sm-3 control-label">Familia</label>
                  <div class="col-sm-9">
                     <input class="form-control" type="text" name="familia_nombre" required maxlength="100"
                            placeholder="Ej: Pernos inoxidable" list="familias_disponibles_dl" autocomplete="off"/>
                     <datalist id="familias_disponibles_dl">
                        {% for fam_disp in fsc.familias_disponibles %}
                        <option value="{{ fam_disp.descripcion }}"></option>
                        {% endfor %}
                     </datalist>
                     <p class="help-block text-muted">
                        <small>Escribe el nombre de la familia. Si ya existe en el catálogo se vincula a la tarifa; si no existe, se crea automáticamente.</small>
                     </p>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-3 control-label">Familia madre</label>
                  <div class="col-sm-9">
                     <select class="form-control" name="madre" id="add_madre"
                             hx-get="{{ fsc.url() ~ '&codtarifa=' ~ fsc.codtarifa ~ '&action=get_next_capitulo' }}"
                             hx-trigger="change"
                             hx-target="#add_capitulo_preview"
                             hx-swap="outerHTML">
                        <option value="">-- Raíz (sin madre) --</option>
                        {% for fam_flat in fsc.get_familias_flat() %}
                        <option value="{{ fam_flat.codfamilia }}">{{ fam_flat.nivel }}{{ fam_flat.descripcion }}</option>
                        {% endfor %}
                     </select>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-3 control-label">Capítulo</label>
                  <div class="col-sm-9">
                     <p class="form-control-static">
                        Se asignará automáticamente: <strong id="add_capitulo_preview">1</strong>
                     </p>
                  </div>
               </div>
               <div class="form-group">
                  <label class="col-sm-3 control-label">Visibilidad</label>
                  <div class="col-sm-9">
                     {{ tarif.toggle_button_group({'en_catalogo': true, 'en_tarifa': true, 'activa': true}) }}
                     <p class="help-block text-muted" style="margin-top: 10px;">
                        <small>"En tarifa" marca las familias que se incluirán al exportar la tarifa para clientes.</small>
                     </p>
                  </div>
               </div>
            </div>
            <div class="modal-footer">
               <button type="button" class="btn btn-default" @click="close()">Cancelar</button>
               <button class="btn btn-primary" type="submit">
                  <span class="glyphicon glyphicon-plus"></span>&nbsp; Añadir
               </button>
            </div>
            </form>
         </div>
      </div>
   </div>
</div>
{% endif %}

{# Excel modals — untouched #}
{% if fsc.codtarifa %}
{{ csrf_meta() }}

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/resumablejs@1.1.0/resumable.min.js"></script>

<script type="text/javascript">
window.familiasConfig = {
    codtarifa: '{{ fsc.codtarifa }}',
    baseUrl: '{{ fsc.url() }}'
};

function descargarPlantillaExcel() {
    window.location.href = '{{ fsc.url() }}&codtarifa={{ fsc.codtarifa }}&action=export_excel_template';
}
</script>

<script type="module" src="plugins/catalogo_core/View/js/familias/index.js"></script>

{# Alpine (CSP build) component registration — inline classic script runs
   during parse, BEFORE the deferred Alpine boot below, so the alpine:init
   listener is guaranteed to fire before Alpine walks the tree. #}
<script type="text/javascript">
(function () {
    function registerFamiliaAlpineComponents() {
        // CSP build: directive expressions are limited to method calls; all
        // behavior lives here. Window-level listeners use plain
        // addEventListener so the server's fs:modal-close contract works
        // regardless of where htmx dispatches the event.
        Alpine.data('familiaAddModal', function () {
            return {
                open: false,
                init: function () {
                    window.addEventListener('familias-add-open', this.openModal.bind(this));
                    window.addEventListener('fs:modal-close', this.closeAndReset.bind(this));
                    window.addEventListener('keydown', this.onKeydown.bind(this));
                },
                openModal: function () {
                    this.open = true;
                    document.body.classList.add('modal-open');
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                },
                closeAndReset: function () {
                    this.close();
                    var form = document.querySelector('#modal_add_familia form');
                    if (form) {
                        form.reset();
                    }
                },
                onKeydown: function (e) {
                    if (e.key === 'Escape' && this.open) {
                        this.close();
                    }
                }
            };
        });
        Alpine.data('familiaEditModal', function () {
            return {
                open: true,
                init: function () {
                    window.addEventListener('fs:modal-close', this.close.bind(this));
                    window.addEventListener('keydown', this.onKeydown.bind(this));
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                },
                onKeydown: function (e) {
                    if (e.key === 'Escape' && this.open) {
                        this.close();
                    }
                }
            };
        });
        Alpine.data('familiaExportModal', function () {
            return {
                open: false,
                init: function () {
                    window.addEventListener('familias-export-open', this.openModal.bind(this));
                    window.addEventListener('keydown', this.onKeydown.bind(this));
                },
                openModal: function () {
                    this.open = true;
                    document.body.classList.add('modal-open');
                },
                exportAndClose: function () {
                    if (window.familiasExcelExport) {
                        window.familiasExcelExport.exportarExcel();
                    }
                    this.close();
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                },
                onKeydown: function (e) {
                    if (e.key === 'Escape' && this.open) {
                        this.close();
                    }
                }
            };
        });
        Alpine.data('familiaImportModal', function () {
            return {
                open: false,
                init: function () {
                    window.addEventListener('familias-import-open', this.openModal.bind(this));
                    window.addEventListener('keydown', this.onKeydown.bind(this));
                },
                openModal: function () {
                    this.open = true;
                    document.body.classList.add('modal-open');
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                    // Same contract the old hidden.bs.modal hook provided.
                    if (window.familiasExcelImport) {
                        window.familiasExcelImport.reset();
                    }
                },
                onKeydown: function (e) {
                    if (e.key === 'Escape' && this.open) {
                        this.close();
                    }
                }
            };
        });
    }

    if (window.Alpine) {
        registerFamiliaAlpineComponents();
    } else {
        document.addEventListener('alpine:init', registerFamiliaAlpineComponents);
    }
})();
</script>

{# Alpine CSP build — AFTER the module: the module registers its alpine:init
   component listeners first, then Alpine starts and walks the tree. #}
{{ alpine.boot() }}

