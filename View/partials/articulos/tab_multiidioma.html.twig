{#- Long-description section of the unified article detail pane (AD-7, GDI-11).
    Not a tab: a nested .tab-pane would be hidden by Bootstrap CSS inside #datos,
    so it renders as a plain visible panel and keeps the #multiidioma anchor.

    One textarea per active language, all rendered; the header selector
    (data-idioma-selector, see partials/ficha_assets) shows the selected one
    without reloading. The value is each language's OWN text
    (fsc.descripciones_idioma): rendering a fallback here would materialise it
    into that language on save. The short description lives in the header. -#}
<div class="panel panel-default" id="multiidioma">
    <div class="panel-heading">
        <h3 class="panel-title">{{ 'long-description'|trans }}</h3>
    </div>
    <div class="panel-body">
        {% for idioma in fsc.idiomas %}
        {% set larga = fsc.descripciones_idioma[idioma.codidioma].descripcion_larga ?? '' %}
        <div class="form-group" data-codidioma="{{ idioma.codidioma }}"{% if idioma.codidioma != fsc.codidioma %} hidden{% endif %} style="margin-bottom: 0;">
            <label class="control-label" for="descripcion_larga_{{ idioma.codidioma }}">
                {{ 'long-description'|trans }} <span class="ficha-idioma-tag">({{ idioma.nombre }})</span>
            </label>
            <textarea class="form-control" rows="6" data-contador
                      id="descripcion_larga_{{ idioma.codidioma }}"
                      name="descripcion_larga_{{ idioma.codidioma }}"
                      autocomplete="off">{{ larga }}</textarea>
            <p class="help-block ficha-contador"><span>{{ larga|length }}</span> {{ 'characters'|trans }}</p>
        </div>
        {% else %}
        <div class="alert alert-info">{{ 'no-languages-configured'|trans }}</div>
        {% endfor %}
    </div>
</div>
