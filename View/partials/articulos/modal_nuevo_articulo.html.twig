{#
 # Modal nuevo artículo (estilo tarifario tarif_articulos)
 #}
<form class="form-horizontal" role="form" name="f_nuevo_articulo" action="{{ fsc.url() }}" method="post">
    {{ csrf_field() }}
    <div class="modal fade" id="modal_nuevo_articulo" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"><span>&times;</span></button>
                    <h4 class="modal-title">
                        <i class="fa fa-cube" aria-hidden="true"></i>&nbsp; {{ 'new-article'|trans }}
                    </h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="nreferencia" class="col-sm-2 control-label">{{ 'reference'|trans }}</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" id="nreferencia" name="nreferencia"
                                maxlength="18" placeholder="{{ 'reference'|trans }}" required autocomplete="off"/>
                        </div>
                        <label for="npvp" class="col-sm-2 control-label">{{ 'price'|trans }}</label>
                        <div class="col-sm-4">
                            <input type="number" step="0.01" class="form-control" id="npvp" name="npvp"
                                value="0" placeholder="0.00"/>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="ndescripcion" class="col-sm-2 control-label">{{ 'description'|trans }}</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="ndescripcion" name="ndescripcion"
                                placeholder="{{ 'description'|trans }}" required autocomplete="off"/>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="ncodfamilia" class="col-sm-2 control-label">{{ 'family'|trans }}</label>
                        <div class="col-sm-4">
                            <select class="form-control" id="ncodfamilia" name="ncodfamilia">
                                <option value="">{{ 'none'|trans }}</option>
                                {% for familia in fsc.familias %}
                                    <option value="{{ familia.codfamilia }}">{{ familia.descripcion }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <label for="ncodfabricante" class="col-sm-2 control-label">{{ 'manufacturer'|trans }}</label>
                        <div class="col-sm-4">
                            <select class="form-control" id="ncodfabricante" name="ncodfabricante">
                                <option value="">{{ 'none'|trans }}</option>
                                {% for fabricante in fsc.fabricantes %}
                                    <option value="{{ fabricante.codfabricante }}">{{ fabricante.nombre }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="ncodimpuesto" class="col-sm-2 control-label">{{ 'tax'|trans }}</label>
                        <div class="col-sm-4">
                            <select class="form-control" id="ncodimpuesto" name="ncodimpuesto">
                                {% if fsc.impuestos %}
                                    {% for impuesto in fsc.impuestos %}
                                        <option value="{{ impuesto.codimpuesto }}"{% if impuesto.codimpuesto == fsc.default_codimpuesto %} selected{% endif %}>
                                            {{ impuesto.descripcion }} ({{ impuesto.iva }}%)
                                        </option>
                                    {% endfor %}
                                {% else %}
                                    <option value="{{ fsc.default_codimpuesto }}" selected>{{ fsc.default_codimpuesto }}</option>
                                {% endif %}
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'cancel'|trans }}</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; {{ 'save'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
