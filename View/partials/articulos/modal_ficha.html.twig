{#- Article / optional sheet in a modal, shared by every list that links to
    one (ventas_articulos, tarif_catalogo_view). It frames the real page
    (ventas_articulo, tarif_opcional_edit) instead of re-rendering it as a
    fragment: those pages own full-form POSTs, whole-body htmx swaps and their
    own Alpine components, none of which survive being injected elsewhere.

    Contract: any <a data-articulo-modal href="..."> or <a data-opcional-modal
    href="..."> opens here; a ctrl/shift/middle click still opens the full page.
    The framed page hides the theme chrome by itself (partials/ficha_embebida)
    and flags window.parent.__fichaArticuloCambiada after a save. On close, if
    something changed, a cancelable `ficha:cambiada` event is fired on document
    with detail.link = the opener link; a list that refreshes only what changed
    calls preventDefault(), otherwise the page reloads. Listeners are
    delegated: rows arrive via htmx. -#}
<style>
    #modal_ficha_articulo .modal-dialog { width: 96% !important; max-width: 1500px !important; margin: 15px auto; }
    #modal_ficha_articulo .modal-body { padding: 0; }
    #modal_ficha_articulo iframe { display: block; width: 100%; height: calc(100vh - 110px); border: 0; }
</style>
<div class="modal fade" id="modal_ficha_articulo" tabindex="-1" role="dialog" aria-labelledby="modal_ficha_articulo_title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'close'|trans }}"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="modal_ficha_articulo_title"
                    data-titulo-articulo="{{ 'article'|trans }}" data-titulo-opcional="Opcional"><i class="fa fa-cube" aria-hidden="true"></i>&nbsp; <span>{{ 'article'|trans }}</span></h4>
            </div>
            <div class="modal-body">
                <iframe title="{{ 'article'|trans }}" src="about:blank"></iframe>
            </div>
        </div>
    </div>
</div>
<script {{ csp_nonce_attr() }}>
(function () {
    if (window.__fichaArticuloModalBound === true) { return; }
    window.__fichaArticuloModalBound = true;

    var abierto = null; // opener link of the sheet currently framed
    var paginaAbierta = '';

    function marco() {
        return document.querySelector('#modal_ficha_articulo iframe');
    }

    function avisarCambio() {
        var link = abierto;
        if (window.__fichaArticuloCambiada !== true) { return; }
        window.__fichaArticuloCambiada = false;
        var evt = new CustomEvent('ficha:cambiada', { cancelable: true, detail: { link: link } });
        if (document.dispatchEvent(evt)) { window.location.reload(); }
    }

    document.addEventListener('click', function (evt) {
        var link = evt.target.closest ? evt.target.closest('a[data-articulo-modal], a[data-opcional-modal]') : null;
        var frame = marco();
        if (!link || !frame || evt.button !== 0 || evt.ctrlKey || evt.metaKey || evt.shiftKey) { return; }
        evt.preventDefault();
        var opcional = link.hasAttribute('data-opcional-modal');
        var titulo = document.getElementById('modal_ficha_articulo_title');
        titulo.querySelector('span').textContent = titulo.getAttribute(opcional ? 'data-titulo-opcional' : 'data-titulo-articulo');
        titulo.querySelector('i').className = 'fa ' + (opcional ? 'fa-puzzle-piece' : 'fa-cube');
        abierto = link;
        paginaAbierta = new URL(link.href, window.location.href).searchParams.get('page') || '';
        window.__fichaArticuloCambiada = false;
        frame.src = link.href;
        $('#modal_ficha_articulo').modal('show');
    });

    // The frame left the sheet (e.g. the record was deleted and the controller
    // redirected to a list): close the modal and let the opener refresh,
    // instead of browsing the application inside the modal.
    document.addEventListener('load', function (evt) {
        if (evt.target !== marco()) { return; }
        var destino = null;
        try { destino = new URL(evt.target.contentWindow.location.href); } catch (e) { return; }
        if (destino.href !== 'about:blank' && destino.searchParams.get('page') !== paginaAbierta) {
            window.__fichaArticuloCambiada = true;
            $('#modal_ficha_articulo').modal('hide');
        }
    }, true);

    $(document).on('hidden.bs.modal', '#modal_ficha_articulo', function () {
        var frame = marco();
        if (frame) { frame.src = 'about:blank'; }
        avisarCambio();
        abierto = null;
    });
})();
</script>
