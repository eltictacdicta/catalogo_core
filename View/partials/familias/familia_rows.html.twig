{#
 # Rows partial — renders multiple familia rows inside a tbody.
 # Used by renderTbodyFragment for structural changes (save, add, delete, reorder).
 # Expects: rows (array of familia/estructura objects), fsc (controller instance)
 #
 # The empty state is source-aware: the structure mode counts one extra column
 # (orden) and never claims the rows belong to "esta tarifa".
 #}
<tbody id="familias-tbody">
   {% for fam in rows %}
   {% include 'partials/familias/familia_row.html.twig' with {row: fam, fsc: fsc} %}
   {% else %}
   {% if fsc.family_structure %}
   <tr class="warning">
      <td colspan="10">
         {{ 'catalogo-core-estructura-empty'|trans }}
         <a href="#" onclick="document.dispatchEvent(new CustomEvent('familias-add-open', {bubbles: true})); return false;">Añadir familia</a>.
      </td>
   </tr>
   {% else %}
   <tr class="warning">
      <td colspan="9">
         No hay familias en esta tarifa.
         {% if fsc.familias_disponibles|length > 0 %}
         <a href="#" data-toggle="modal" data-target="#modal_add_familia">Añadir familias</a>
         {% else %}
         <a href="index.php?page=ventas_familia">Crear familias primero</a>
         {% endif %}
      </td>
   </tr>
   {% endif %}
   {% endfor %}
</tbody>
