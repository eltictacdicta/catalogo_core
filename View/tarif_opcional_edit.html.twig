{% include 'header.html.twig' %}
{% import 'Macro/TarifarioComponents.html.twig' as tarif %}
{% import 'Macro/Htmx.html.twig' as htmx %}
{% import 'Macro/Alpine.html.twig' as alpine %}

{# htmx 4 boot: inherited CSRF headers on every request. allowScriptTags:false
   scrubs the scripts of the incoming body before a swap (AD-5), because this
   page swaps its own <body> on selector change. #}
{{ htmx.boot({'allowScriptTags': false}) }}

{% if fsc.opcional %}
<style>
   [x-cloak] {
      display: none !important;
   }
   .opcional-alpine-backdrop {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 1050;
      overflow-y: auto;
      background: rgba(0, 0, 0, 0.5);
   }
</style>

{% if fsc.tarifas|length > 0 %}
{# Tarifa selector — validated by resolver_tarifa_seleccionada(); htmx swaps the
   whole body and pushes the URL so the selected tarifa scopes the page. #}
<div class="container-fluid" style="margin-bottom: 10px;">
   <div class="row">
      <div class="col-sm-5">
         <div class="form-group" style="margin-bottom: 0;">
            <label class="control-label"><span class="glyphicon glyphicon-tags"></span>&nbsp;Tarifa:</label>
            <select name="codtarifa" class="form-control"
                    hx-get="{{ fsc.opcional.url() }}"
                    hx-trigger="change"
                    hx-target="body"
                    hx-select="body"
                    hx-swap="outerHTML"
                    hx-push-url="true"
                    hx-boost="true">
               {% for tarifa in fsc.tarifas %}
               <option value="{{ tarifa.codtarifa }}"{% if tarifa.codtarifa == fsc.tarifa_seleccionada.codtarifa %} selected{% endif %}>{{ tarifa.nombre }}{% if tarifa.por_defecto %} ★{% endif %}</option>
               {% endfor %}
            </select>
         </div>
      </div>
      <div class="col-sm-7 text-right">
         <span class="label label-info" style="font-size: 14px;">
            <span class="glyphicon glyphicon-tags"></span>&nbsp;
            Tarifa activa:
            <strong>{{ fsc.tarifa_seleccionada.nombre }}</strong>
            {% if fsc.tarifa_seleccionada.por_defecto %}
            <span class="glyphicon glyphicon-star" title="Tarifa por defecto"></span>
            {% endif %}
         </span>
      </div>
   </div>
</div>
{% endif %}

<div class="container-fluid" style="margin-bottom: 10px;">
   <div class="row">
      <div class="col-xs-12">
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="index.php?page=ventas_opcionales&b_codtarifa={{ fsc.codtarifa|url_encode }}" title="Volver al listado">
               <span class="glyphicon glyphicon-arrow-left"></span>
               <span class="hidden-xs">&nbsp;Volver</span>
            </a>
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" title="Recargar">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
         </div>
      </div>
   </div>
</div>

{# Shared confirm component: one Alpine instance wraps the tab content so the
   familias/artículos buttons resolve their methods through the scope chain. #}
<div role="tabpanel" x-data="opcionalConfirmAction" data-post-url="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}">
   <ul id="ul_tabs" class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
         <a href="#datos" aria-controls="datos" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-edit" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Datos</span>
         </a>
      </li>
      <li role="presentation">
         <a href="#familias" aria-controls="familias" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-folder-open" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Familias</span>
            <span class="badge">{{ fsc.familias_asignadas|length }}</span>
         </a>
      </li>
      <li role="presentation">
         <a href="#articulos" aria-controls="articulos" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-th-list" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Artículos</span>
            <span class="badge">{{ fsc.articulos|length }}</span>
         </a>
      </li>
      {% if fsc.tarifas|length > 0 %}
      <li role="presentation">
         <a href="#precios_tarifas" aria-controls="precios_tarifas" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-tags" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Precios por tarifa</span>
         </a>
      </li>
      {% endif %}
   </ul>

   <div class="tab-content">
      <div role="tabpanel" class="tab-pane active" id="datos">
         <form action="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" method="post" class="form">
            <input type="hidden" name="codtarifa" value="{{ fsc.codtarifa }}"/>
            <div class="container-fluid" style="margin-top: 15px;">
               <div class="row">
                  <div class="col-sm-6">
                     <div class="panel panel-primary">
                        <div class="panel-heading"><h3 class="panel-title">Información del opcional</h3></div>
                        <div class="panel-body">
                           <div class="form-group"><label>Código</label><input class="form-control" type="text" name="codigo" value="{{ fsc.opcional.codigo }}" maxlength="30"/></div>
                           <div class="form-group"><label>REF</label><input class="form-control" type="text" name="ref_sap" value="{{ fsc.opcional.ref_sap }}" maxlength="50" placeholder="SKU / Referencia SAP"/></div>
                           <div class="form-group"><label>Nombre</label><input class="form-control" type="text" name="nombre" value="{{ fsc.opcional.nombre }}" maxlength="100" required/></div>
                           <div class="form-group"><label>Descripción</label><textarea class="form-control" name="descripcion" rows="3">{{ fsc.opcional.descripcion }}</textarea></div>
                           <div class="form-group"><label class="checkbox-inline"><input type="checkbox" name="activo" value="TRUE" {% if fsc.opcional.activo %}checked{% endif %}/> Opcional activo</label></div>
                        </div>
                     </div>
                  </div>
                  <div class="col-sm-6">
                     <div class="panel panel-info">
                        <div class="panel-heading"><h3 class="panel-title">Resumen</h3></div>
                        <div class="panel-body">
                           <p><b>Familias asociadas:</b> {{ fsc.familias_asignadas|length }}</p>
                           <p><b>Artículos asociados:</b> {{ fsc.articulos|length }}</p>
                        </div>
                     </div>
                  </div>
               </div>
               <div class="row"><div class="col-sm-12 text-right"><button class="btn btn-primary" type="submit"><span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar</button></div></div>
            </div>
         </form>
      </div>

      <div role="tabpanel" class="tab-pane" id="familias">
         <div class="container-fluid" style="margin-top: 15px;">
            <div class="row"><div class="col-sm-12"><div class="alert alert-info"><label><input type="checkbox" id="propagate_opcional" checked="checked"/> <b>Propagar a artículos</b></label><p class="text-muted" style="margin-bottom: 0;">Si está marcado, al añadir un opcional a una familia se asignará automáticamente a todos los artículos de esa familia.</p></div></div></div>
            <div class="row">
               <div class="col-sm-6">
                  <div class="panel panel-default">
                     <div class="panel-heading"><h3 class="panel-title">Familias asignadas</h3></div>
                     <div class="panel-body">
                        {% if fsc.familias_asignadas|length > 0 %}
                        <table class="table table-hover">
                           <thead><tr><th>Código</th><th>Descripción</th><th>Etiquetas</th><th></th></tr></thead>
                           <tbody>
                              {% for fam in fsc.familias_asignadas %}
                              <tr>
                                 <td>{{ fam.codfamilia }}</td>
                                 <td>{{ fam.descripcion }}</td>
                                 <td style="min-width: 260px;">
                                    <form action="index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|url_encode }}#familias" method="post" class="form-inline" style="margin: 0;">
                                       <input type="hidden" name="save_etiquetas_familia" value="1"/>
                                       <input type="hidden" name="codfamilia" value="{{ fam.codfamilia }}"/>
                                       {% set etiquetas_disponibles = fsc.get_etiquetas_disponibles_familia(fam.codfamilia) %}
                                       {% set etiquetas_seleccionadas = fsc.get_etiquetas_opcional_familia(fam.codfamilia) %}
                                       <select name="etiquetas_familia[]" class="form-control input-sm" multiple size="3" style="width: 190px;">
                                          {% for tag in etiquetas_disponibles %}
                                          <option value="{{ tag }}" {% if tag in etiquetas_seleccionadas %}selected{% endif %}>{{ tag }}</option>
                                          {% endfor %}
                                       </select>
                                       <button class="btn btn-xs btn-primary" type="submit" title="Guardar etiquetas de esta familia">
                                          <span class="glyphicon glyphicon-floppy-disk"></span>
                                       </button>
                                       {% if etiquetas_disponibles|length > 0 %}
                                       <div class="text-muted" style="font-size: 11px; margin-top: 4px;">Ctrl/Cmd + clic para multi-selección.</div>
                                       {% else %}
                                       <div class="text-muted" style="font-size: 11px; margin-top: 4px;">Sin etiquetas definidas en esta familia.</div>
                                       {% endif %}
                                    </form>
                                 </td>
                                 <td class="text-right">
                                    {% if fsc.allow_delete %}
                                    <button type="button" class="btn btn-xs btn-danger" x-on:click="askRemoveFamilia('{{ fam.codfamilia|e('js') }}', '{{ fam.descripcion|e('js') }}', 'true')" title="Quitar (con propagación)"><span class="glyphicon glyphicon-remove"></span> P</button>
                                    <button type="button" class="btn btn-xs btn-warning" x-on:click="askRemoveFamilia('{{ fam.codfamilia|e('js') }}', '{{ fam.descripcion|e('js') }}', 'false')" title="Quitar (sin propagación)"><span class="glyphicon glyphicon-remove"></span></button>
                                    {% endif %}
                                 </td>
                              </tr>
                              {% endfor %}
                           </tbody>
                        </table>
                        {% else %}
                        <p class="text-muted">No hay familias asignadas a este opcional.</p>
                        {% endif %}
                     </div>
                  </div>
               </div>
               <div class="col-sm-6">
                  <div class="panel panel-success">
                     <div class="panel-heading"><h3 class="panel-title">Familias disponibles</h3></div>
                     <div class="panel-body">
                        {% set familias_disponibles = fsc.get_familias_disponibles() %}
                        {% if familias_disponibles|length > 0 %}
                        <table class="table table-hover">
                           <thead><tr><th>Código</th><th>Descripción</th><th></th></tr></thead>
                           <tbody>
                              {% for fam in familias_disponibles %}
                              <tr>
                                 <td>{{ fam.codfamilia }}</td>
                                 <td>{{ fam.nivel }}{{ fam.descripcion }}</td>
                                 <td class="text-right">
                                    <button type="button" class="btn btn-xs btn-success" x-on:click="askAddFamilia('{{ fam.codfamilia|e('js') }}', 'true')" title="Añadir (con propagación)"><span class="glyphicon glyphicon-plus"></span> P</button>
                                    <button type="button" class="btn btn-xs btn-default" x-on:click="askAddFamilia('{{ fam.codfamilia|e('js') }}', 'false')" title="Añadir (sin propagación)"><span class="glyphicon glyphicon-plus"></span></button>
                                 </td>
                              </tr>
                              {% endfor %}
                           </tbody>
                        </table>
                        {% else %}
                        <p class="text-muted">No hay más familias disponibles.</p>
                        {% endif %}
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="articulos">
         <div class="container-fluid" style="margin-top: 15px;">
            <div class="row"><div class="col-sm-12"><div class="panel panel-info"><div class="panel-heading"><h3 class="panel-title">Buscar artículos para añadir</h3></div><div class="panel-body">
               <div class="form-group" x-data="opcionalArticuloSearch" data-lookup-url="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" data-post-url="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" style="position: relative;">
                  <div class="input-group">
                     <input type="text" class="form-control" placeholder="Buscar por referencia o descripción..." autocomplete="off" x-model="query" x-on:input.debounce.300ms="search()"/>
                     <span class="input-group-addon"><span class="glyphicon glyphicon-search" x-show="!loading"></span><span class="glyphicon glyphicon-refresh" x-show="loading" x-cloak></span></span>
                  </div>
                  <div class="list-group" x-show="open" x-cloak style="position: absolute; z-index: 1000; width: 100%; max-height: 280px; overflow-y: auto;">
                     <template x-for="item in results" :key="item.referencia">
                        <button type="button" class="list-group-item" x-on:click="select(item.referencia)">
                           <span x-text="item.value"></span>
                        </button>
                     </template>
                  </div>
                  <p class="help-block">Escribe para buscar y haz clic en el resultado para añadirlo.</p>
               </div>
            </div></div></div></div>
            <div class="row"><div class="col-sm-12"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">Artículos asociados ({{ fsc.articulos|length }})</h3></div><div class="panel-body">
               {% if fsc.articulos|length > 0 %}
               <table class="table table-hover"><thead><tr><th>Referencia</th><th>Descripción</th><th>Familia</th><th class="text-right">Precio</th><th></th></tr></thead><tbody>
               {% for art in fsc.articulos %}
               <tr><td><a href="{{ art.url() }}">{{ art.referencia }}</a></td><td>{{ art.descripcion(fsc.codidioma, 60) }}</td><td>{{ art.codfamilia }}</td><td class="text-right">{{ fsc.show_precio(art.precio, false, true, constant('FS_NF0_ART')) }}</td><td class="text-right">{% if fsc.allow_delete %}<button type="button" class="btn btn-xs btn-danger" x-on:click="askRemoveArticulo('{{ art.referencia|e('js') }}')" title="Quitar"><span class="glyphicon glyphicon-remove"></span></button>{% endif %}</td></tr>
               {% endfor %}
               </tbody></table>
               {% else %}<p class="text-muted">No hay artículos asociados a este opcional.</p>{% endif %}
            </div></div></div></div>
         </div>
      </div>

      {% if fsc.tarifas|length > 0 and fsc.tarifa_seleccionada %}
      <div role="tabpanel" class="tab-pane" id="precios_tarifas">
         <div class="container-fluid" style="margin-top: 15px;">
            <div class="row">
               <div class="col-sm-8">
                  <p class="text-muted">Active este opcional en la tarifa seleccionada, marque su visibilidad y defina su precio. Cambie de tarifa en el selector superior para editar otra.</p>
                  {# Scoped editable panel: exactly one tarifa (fsc.tarifa_seleccionada). #}
                  <form action="{{ fsc.opcional.url() }}&codtarifa={{ fsc.tarifa_seleccionada.codtarifa|url_encode }}" method="post" class="form"
                        hx-post="{{ fsc.opcional.url() }}&codtarifa={{ fsc.tarifa_seleccionada.codtarifa|url_encode }}"
                        hx-target="body" hx-select="body" hx-swap="outerHTML"
                        x-data="opcionalSaveFeedback" x-on:submit="markSaving()">
                     {{ csrf_field() }}
                     <input type="hidden" name="guardar_precio_tarifa" value="1"/>
                     <input type="hidden" name="codtarifa" value="{{ fsc.tarifa_seleccionada.codtarifa }}"/>
                     <div class="panel {% if fsc.opcional_activo_en_tarifa(fsc.tarifa_seleccionada.codtarifa) %}panel-success{% else %}panel-default{% endif %}">
                        <div class="panel-heading">
                           <h3 class="panel-title">
                              <span class="glyphicon glyphicon-tags"></span>&nbsp;
                              <b>{{ fsc.tarifa_seleccionada.nombre }}</b>
                              <span class="text-muted">({{ fsc.tarifa_seleccionada.codtarifa }})</span>
                              {% if fsc.tarifa_seleccionada.por_defecto %}<span class="label label-primary"><span class="glyphicon glyphicon-star"></span></span>{% endif %}
                           </h3>
                        </div>
                        <div class="panel-body">
                           <div class="row">
                              <div class="col-sm-6">
                                 {# Only the surviving `activa` control is editable (OTS-02/OTS-05).
                                    Catalog/tarifa visibility is derived from the parent product
                                    (D12/OUM-03) and rendered read-only: no input targets
                                    en_catalogo/en_tarifa. #}
                                 {{ tarif.toggle_button_group({'activa': fsc.opcional_activo_en_tarifa(fsc.tarifa_seleccionada.codtarifa)}, {'show_catalogo': false, 'show_en_tarifa': false, 'size': 'sm'}) }}
                                 <span class="text-muted" style="margin-left: 8px;">
                                    Catálogo:
                                    {% if fsc.opcional_en_catalogo_tarifa(fsc.tarifa_seleccionada.codtarifa) %}
                                    <span class="label label-success">Sí</span>
                                    {% else %}
                                    <span class="label label-default">No</span>
                                    {% endif %}
                                    &nbsp;En tarifa:
                                    {% if fsc.opcional_en_tarifa_flag(fsc.tarifa_seleccionada.codtarifa) %}
                                    <span class="label label-info">Sí</span>
                                    {% else %}
                                    <span class="label label-default">No</span>
                                    {% endif %}
                                 </span>
                              </div>
                               <div class="col-sm-4">
                                  {# The accepted input follows the opcional's price mode (OPG-01). #}
                                  {% if fsc.opcional.es_precio_porcentaje() %}
                                  <div class="input-group input-group-sm">
                                     <input type="text" class="form-control text-right" name="porcentaje" value="{{ fsc.get_porcentaje_tarifa(fsc.tarifa_seleccionada.codtarifa) }}" placeholder="0.00" autocomplete="off"/>
                                     <div class="input-group-addon">%</div>
                                  </div>
                                  {% else %}
                                  <div class="input-group input-group-sm">
                                     <input type="text" class="form-control text-right" name="precio" value="{{ fsc.get_precio_tarifa(fsc.tarifa_seleccionada.codtarifa) }}" placeholder="0.00" autocomplete="off"/>
                                     <div class="input-group-addon">{{ fsc.simbolo_divisa(fsc.tarifa_seleccionada.coddivisa) }}</div>
                                  </div>
                                  {% endif %}
                               </div>
                              <div class="col-sm-2 text-right">
                                 <button class="btn btn-sm btn-primary" type="submit" :disabled="saving" title="Guardar {{ fsc.tarifa_seleccionada.nombre }}"><span class="glyphicon glyphicon-floppy-disk" x-show="!saving"></span><span class="glyphicon glyphicon-refresh" x-show="saving" x-cloak></span></button>
                              </div>
                           </div>
                        </div>
                     </div>
                  </form>

                  {# Compact read-only overview of every tarifa (OTS-02). #}
                  <div class="panel panel-default">
                     <div class="panel-heading"><h3 class="panel-title">Resumen por tarifa</h3></div>
                     <div class="panel-body" style="padding: 0;">
                        <table class="table table-condensed table-hover" style="margin-bottom: 0;">
                           <thead><tr><th>Tarifa</th><th>Activa</th><th>Catálogo</th><th>En tarifa</th><th class="text-right">Precio</th></tr></thead>
                           <tbody>
                              {% for codtarifa, datos in fsc.precios_tarifas %}
                              <tr{% if codtarifa == fsc.tarifa_seleccionada.codtarifa %} class="info"{% endif %}>
                                 <td>
                                    {{ datos.tarifa.nombre }}
                                    <small class="text-muted">({{ codtarifa }})</small>
                                    {% if datos.tarifa.por_defecto %}<span class="glyphicon glyphicon-star text-primary"></span>{% endif %}
                                 </td>
                                 <td>{% if datos.activa %}<span class="glyphicon glyphicon-ok text-success"></span>{% else %}<span class="glyphicon glyphicon-remove text-muted"></span>{% endif %}</td>
                                 <td>{% if datos.en_catalogo %}<span class="glyphicon glyphicon-ok text-success"></span>{% else %}<span class="glyphicon glyphicon-remove text-muted"></span>{% endif %}</td>
                                 <td>{% if datos.en_tarifa %}<span class="glyphicon glyphicon-ok text-success"></span>{% else %}<span class="glyphicon glyphicon-remove text-muted"></span>{% endif %}</td>
                                  <td class="text-right">
                                     {% if datos.es_porcentaje %}
                                        {% if datos.porcentaje is not null %}{{ datos.porcentaje }}%{% else %}<span class="text-muted">—</span>{% endif %}
                                     {% elseif datos.precio is not null %}
                                        {{ datos.precio }}
                                     {% else %}
                                        <span class="text-muted">—</span>
                                     {% endif %}
                                  </td>
                              </tr>
                              {% endfor %}
                           </tbody>
                        </table>
                     </div>
                  </div>
               </div>
               <div class="col-sm-4">
                  <div class="panel panel-info">
                     <div class="panel-heading"><h3 class="panel-title">Información</h3></div>
                     <div class="panel-body">
                        <p><span class="glyphicon glyphicon-eye"></span> <b>En catálogo:</b> Visible en el catálogo de esa tarifa.</p>
                        <p><span class="glyphicon glyphicon-file-text-o"></span> <b>En tarifa:</b> Se incluye al exportar la tarifa.</p>
                        <p><span class="glyphicon glyphicon-check"></span> <b>Activa:</b> El opcional está disponible en esa tarifa.</p>
                        <p><span class="glyphicon glyphicon-euro"></span> <b>Precio:</b> Puede ser diferente para cada tarifa.</p>
                        <p><span class="glyphicon glyphicon-star text-primary"></span> La tarifa marcada es la por defecto.</p>
                        <p><span class="glyphicon glyphicon-cog"></span> <a href="index.php?page=tarif_tarifas">Gestionar tarifas</a></p>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {% endif %}
   </div>

   {# CSP-safe confirm dialog for the migrated familia/artículo flows. #}
   <div class="modal opcional-alpine-backdrop" x-show="open" x-cloak role="dialog">
      <div class="modal-dialog" role="document">
         <div class="modal-content">
            <div class="modal-header">
               <button type="button" class="close" x-on:click="close()"><span>&times;</span></button>
               <h4 class="modal-title" x-text="title"></h4>
            </div>
            <div class="modal-body"><p x-text="message" style="white-space: pre-line;"></p></div>
            <div class="modal-footer">
               <button type="button" class="btn btn-default" x-on:click="close()">Cancelar</button>
               <button type="button" class="btn btn-primary" x-on:click="confirm()">Aceptar</button>
            </div>
         </div>
      </div>
   </div>
</div>

{# Alpine CSP registration (runs during parse, before the deferred Alpine
   boot) + idempotent re-init after an htmx body swap. #}
<script {{ csp_nonce_attr() }}>
(function () {
    if (window.__opcionalesAlpineRegistered === true) { return; }

    function registerOpcionalesAlpineComponents() {
        if (window.__opcionalesAlpineRegistered === true) { return; }
        window.__opcionalesAlpineRegistered = true;

        Alpine.data('opcionalConfirmAction', function () {
            return {
                open: false,
                title: '',
                message: '',
                url: '',
                values: {},
                init: function () { this.url = this.$el.dataset.postUrl || ''; },
                openModal: function (title, message, values) {
                    this.title = title;
                    this.message = message;
                    this.values = values;
                    this.open = true;
                    document.body.classList.add('modal-open');
                },
                askAddFamilia: function (cod, propagate) {
                    this.openModal('Añadir familia', '¿Añadir la familia "' + cod + '" a este opcional?',
                        { add_familia: cod, propagate: propagate });
                },
                askRemoveFamilia: function (cod, nombre, propagate) {
                    this.openModal('Eliminar familia', '¿Eliminar la familia "' + nombre + '" de este opcional?',
                        { remove_familia: cod, propagate: propagate });
                },
                askRemoveArticulo: function (ref) {
                    this.openModal('Eliminar artículo', '¿Eliminar el artículo "' + ref + '" de este opcional?',
                        { remove_articulo: ref });
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                },
                confirm: function () {
                    if (window.htmx && window.htmx.ajax) {
                        window.htmx.ajax('POST', this.url, {
                            values: this.values,
                            target: 'body',
                            swap: 'outerHTML',
                            select: 'body'
                        });
                    }
                    this.close();
                }
            };
        });

        Alpine.data('opcionalArticuloSearch', function () {
            return {
                query: '',
                results: [],
                open: false,
                loading: false,
                lookupUrl: '',
                postUrl: '',
                init: function () {
                    this.lookupUrl = this.$el.dataset.lookupUrl || '';
                    this.postUrl = this.$el.dataset.postUrl || '';
                },
                search: function () {
                    if (this.query.length < 2) { this.results = []; this.open = false; return; }
                    var self = this;
                    this.loading = true;
                    fetch(this.lookupUrl + '&buscar_articulo=' + encodeURIComponent(this.query))
                        .then(function (r) { return r.json(); })
                        .then(function (data) { self.results = data.suggestions || []; self.open = self.results.length > 0; })
                        .finally(function () { self.loading = false; });
                },
                select: function (referencia) {
                    this.open = false;
                    this.query = '';
                    this.results = [];
                    if (window.htmx && window.htmx.ajax) {
                        window.htmx.ajax('POST', this.postUrl, {
                            values: { add_articulo: referencia },
                            target: 'body',
                            swap: 'outerHTML',
                            select: 'body'
                        });
                    }
                },
                close: function () { this.open = false; }
            };
        });

        Alpine.data('opcionalSaveFeedback', function () {
            return {
                saving: false,
                init: function () {
                    this._onDone = this.markIdle.bind(this);
                    document.addEventListener('htmx:after:request', this._onDone);
                },
                destroy: function () {
                    document.removeEventListener('htmx:after:request', this._onDone);
                },
                markSaving: function () { this.saving = true; },
                markIdle: function () { this.saving = false; }
            };
        });
    }

    if (window.Alpine) {
        registerOpcionalesAlpineComponents();
    } else {
        document.addEventListener('alpine:init', registerOpcionalesAlpineComponents);
    }
})();

// htmx 4 re-executes swapped body scripts: the marker keeps this listener and
// the Alpine.data registrations installed exactly once (AD-5/R11).
(function () {
    if (window.__opcionalesSwapBound === true) { return; }
    window.__opcionalesSwapBound = true;

    document.addEventListener('htmx:after:swap', function (evt) {
        if (!window.Alpine || typeof window.Alpine.initTree !== 'function') { return; }
        var ctx = evt && evt.detail ? evt.detail.ctx : null;
        var target = ctx && ctx.target ? ctx.target : document.body;
        window.Alpine.initTree(target);
    });
})();
</script>

{{ alpine.boot() }}

{% else %}
<div class="container-fluid">
   <div class="alert alert-danger">
      <span class="glyphicon glyphicon-exclamation-sign"></span>
      &nbsp;Opcional no encontrado.
      <a href="index.php?page=ventas_opcionales">Volver al listado</a>
   </div>
</div>
{% endif %}

