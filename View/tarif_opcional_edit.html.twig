{% include 'header.html.twig' %}

{% if fsc.opcional %}
<script type="text/javascript">
   var defined_autocomplete = false;

   function getPropagateValue() {
      var checkbox = document.getElementById('propagate_opcional');
      return checkbox && checkbox.checked ? 'true' : 'false';
   }

   function añadir_familia(cod, propagate)
   {
      if (propagate === undefined) {
         propagate = getPropagateValue();
      }

      var msg = '¿Añadir la familia "' + cod + '" a este opcional?';
      if (propagate === 'true') {
         msg += '\nEsto también asignará el opcional a TODOS los artículos de esta familia.';
      }

      bootbox.confirm({
         message: msg,
         title: '<b>Atención</b>',
         callback: function(result) {
            if (result) {
               window.location.href = 'index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|e('js') }}&add_familia=' + encodeURIComponent(cod) + '&propagate=' + propagate + '#familias';
            }
         }
      });
   }

   function eliminar_familia(cod, nombre, propagate)
   {
      if (propagate === undefined) {
         propagate = getPropagateValue();
      }

      var msg = '¿Eliminar la familia "' + nombre + '" de este opcional?';
      if (propagate === 'true') {
         msg += '\nEsto también eliminará el opcional de TODOS los artículos de esta familia.';
      }

      bootbox.confirm({
         message: msg,
         title: '<b>Atención</b>',
         callback: function(result) {
            if (result) {
               window.location.href = 'index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|e('js') }}&remove_familia=' + encodeURIComponent(cod) + '&propagate=' + propagate + '#familias';
            }
         }
      });
   }

   function eliminar_articulo(ref)
   {
      bootbox.confirm({
         message: '¿Eliminar el artículo "' + ref + '" de este opcional?',
         title: '<b>Atención</b>',
         callback: function(result) {
            if (result) {
               window.location.href = 'index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|e('js') }}&remove_articulo=' + encodeURIComponent(ref) + '#articulos';
            }
         }
      });
   }

   function setup_autocomplete()
   {
      if (!defined_autocomplete) {
         defined_autocomplete = true;
         $('#buscar_articulo').autocomplete({
            serviceUrl: 'index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|e('js') }}',
            paramName: 'buscar_articulo',
            onSelect: function(suggestion) {
               window.location.href = 'index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|e('js') }}&add_articulo=' + encodeURIComponent(suggestion.referencia) + '#articulos';
            }
         });
      }
   }

   function toggleTarifaRow(checkbox, codtarifa) {
      var precioInput = document.getElementById('precio_tarifa_' + codtarifa);
      var catalogoCheckbox = document.getElementById('catalogo_tarifa_' + codtarifa);
      var row = checkbox.closest('tr');

      if (checkbox.checked) {
         precioInput.disabled = false;
         catalogoCheckbox.disabled = false;
         row.classList.add('success');
      } else {
         precioInput.disabled = true;
         precioInput.value = '';
         catalogoCheckbox.disabled = true;
         catalogoCheckbox.checked = false;
         row.classList.remove('success');
      }
   }

   $(document).ready(function() {
      $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
         if ($(e.target).attr('href') == '#articulos') {
            setup_autocomplete();
            $('#buscar_articulo').focus();
         }
      });

      if(window.location.hash.substring(1) == 'articulos') {
         $('#ul_tabs a[href="#articulos"]').tab('show');
         setup_autocomplete();
      } else if(window.location.hash.substring(1) == 'familias') {
         $('#ul_tabs a[href="#familias"]').tab('show');
      } else if(window.location.hash.substring(1) == 'precios_tarifas') {
         $('#ul_tabs a[href="#precios_tarifas"]').tab('show');
      }
   });
</script>

<div class="container-fluid" style="margin-bottom: 10px;">
   <div class="row">
      <div class="col-xs-12">
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="index.php?page=tarif_opcionales&codtarifa={{ fsc.codtarifa|url_encode }}" title="Volver al listado">
               <span class="glyphicon glyphicon-arrow-left"></span>
               <span class="hidden-xs">&nbsp;Volver</span>
            </a>
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" title="Recargar">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-info" href="index.php?page=tarif_opcional_precios&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|url_encode }}" title="Gestionar precios por tarifa">
               <span class="glyphicon glyphicon-tags"></span>
               <span class="hidden-xs">&nbsp;Precios por tarifa</span>
            </a>
         </div>
      </div>
   </div>
</div>

<div role="tabpanel">
   <ul id="ul_tabs" class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
         <a href="#datos" aria-controls="datos" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-edit" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Datos</span>
         </a>
      </li>
      <li role="presentation">
         <a href="#familias" aria-controls="familias" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-folder-open" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Familias</span>
            <span class="badge">{{ fsc.familias_asignadas|length }}</span>
         </a>
      </li>
      <li role="presentation">
         <a href="#articulos" aria-controls="articulos" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-th-list" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Artículos</span>
            <span class="badge">{{ fsc.articulos|length }}</span>
         </a>
      </li>
      {% if fsc.tarifas|length > 0 %}
      <li role="presentation">
         <a href="#precios_tarifas" aria-controls="precios_tarifas" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-tags" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp;Precios por tarifa</span>
         </a>
      </li>
      {% endif %}
   </ul>

   <div class="tab-content">
      <div role="tabpanel" class="tab-pane active" id="datos">
         <form action="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" method="post" class="form">
            <input type="hidden" name="codtarifa" value="{{ fsc.codtarifa }}"/>
            <div class="container-fluid" style="margin-top: 15px;">
               <div class="row">
                  <div class="col-sm-6">
                     <div class="panel panel-primary">
                        <div class="panel-heading"><h3 class="panel-title">Información del opcional</h3></div>
                        <div class="panel-body">
                           <div class="form-group"><label>Código</label><input class="form-control" type="text" name="codigo" value="{{ fsc.opcional.codigo }}" maxlength="30"/></div>
                           <div class="form-group"><label>REF</label><input class="form-control" type="text" name="ref_sap" value="{{ fsc.opcional.ref_sap }}" maxlength="50" placeholder="SKU / Referencia SAP"/></div>
                           <div class="form-group"><label>Nombre</label><input class="form-control" type="text" name="nombre" value="{{ fsc.opcional.nombre }}" maxlength="100" required/></div>
                           <div class="form-group"><label>Descripción</label><textarea class="form-control" name="descripcion" rows="3">{{ fsc.opcional.descripcion }}</textarea></div>
                           <div class="form-group"><label class="checkbox-inline"><input type="checkbox" name="activo" value="TRUE" {% if fsc.opcional.activo %}checked{% endif %}/> Opcional activo</label></div>
                        </div>
                     </div>
                  </div>
                  <div class="col-sm-6">
                     <div class="panel panel-info">
                        <div class="panel-heading"><h3 class="panel-title">Resumen</h3></div>
                        <div class="panel-body">
                           <p><b>Familias asociadas:</b> {{ fsc.familias_asignadas|length }}</p>
                           <p><b>Artículos asociados:</b> {{ fsc.articulos|length }}</p>
                        </div>
                     </div>
                  </div>
               </div>
               <div class="row"><div class="col-sm-12 text-right"><button class="btn btn-primary" type="submit"><span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar</button></div></div>
            </div>
         </form>
      </div>

      <div role="tabpanel" class="tab-pane" id="familias">
         <div class="container-fluid" style="margin-top: 15px;">
            <div class="row"><div class="col-sm-12"><div class="alert alert-info"><label><input type="checkbox" id="propagate_opcional" checked="checked"/> <b>Propagar a artículos</b></label><p class="text-muted" style="margin-bottom: 0;">Si está marcado, al añadir un opcional a una familia se asignará automáticamente a todos los artículos de esa familia.</p></div></div></div>
            <div class="row">
               <div class="col-sm-6">
                  <div class="panel panel-default">
                     <div class="panel-heading"><h3 class="panel-title">Familias asignadas</h3></div>
                     <div class="panel-body">
                        {% if fsc.familias_asignadas|length > 0 %}
                        <table class="table table-hover">
                           <thead><tr><th>Código</th><th>Descripción</th><th>Etiquetas</th><th></th></tr></thead>
                           <tbody>
                              {% for fam in fsc.familias_asignadas %}
                              <tr>
                                 <td>{{ fam.codfamilia }}</td>
                                 <td>{{ fam.descripcion }}</td>
                                 <td style="min-width: 260px;">
                                    <form action="index.php?page=tarif_opcional_edit&id={{ fsc.opcional.id }}&codtarifa={{ fsc.codtarifa|url_encode }}#familias" method="post" class="form-inline" style="margin: 0;">
                                       <input type="hidden" name="save_etiquetas_familia" value="1"/>
                                       <input type="hidden" name="codfamilia" value="{{ fam.codfamilia }}"/>
                                       {% set etiquetas_disponibles = fsc.get_etiquetas_disponibles_familia(fam.codfamilia) %}
                                       {% set etiquetas_seleccionadas = fsc.get_etiquetas_opcional_familia(fam.codfamilia) %}
                                       <select name="etiquetas_familia[]" class="form-control input-sm" multiple size="3" style="width: 190px;">
                                          {% for tag in etiquetas_disponibles %}
                                          <option value="{{ tag }}" {% if tag in etiquetas_seleccionadas %}selected{% endif %}>{{ tag }}</option>
                                          {% endfor %}
                                       </select>
                                       <button class="btn btn-xs btn-primary" type="submit" title="Guardar etiquetas de esta familia">
                                          <span class="glyphicon glyphicon-floppy-disk"></span>
                                       </button>
                                       {% if etiquetas_disponibles|length > 0 %}
                                       <div class="text-muted" style="font-size: 11px; margin-top: 4px;">Ctrl/Cmd + clic para multi-selección.</div>
                                       {% else %}
                                       <div class="text-muted" style="font-size: 11px; margin-top: 4px;">Sin etiquetas definidas en esta familia.</div>
                                       {% endif %}
                                    </form>
                                 </td>
                                 <td class="text-right">
                                    {% if fsc.allow_delete %}
                                    <a href="#" class="btn btn-xs btn-danger" onclick="eliminar_familia('{{ fam.codfamilia|e('js') }}', '{{ fam.descripcion|e('js') }}', true)" title="Quitar (con propagación)"><span class="glyphicon glyphicon-remove"></span> P</a>
                                    <a href="#" class="btn btn-xs btn-warning" onclick="eliminar_familia('{{ fam.codfamilia|e('js') }}', '{{ fam.descripcion|e('js') }}', false)" title="Quitar (sin propagación)"><span class="glyphicon glyphicon-remove"></span></a>
                                    {% endif %}
                                 </td>
                              </tr>
                              {% endfor %}
                           </tbody>
                        </table>
                        {% else %}
                        <p class="text-muted">No hay familias asignadas a este opcional.</p>
                        {% endif %}
                     </div>
                  </div>
               </div>
               <div class="col-sm-6">
                  <div class="panel panel-success">
                     <div class="panel-heading"><h3 class="panel-title">Familias disponibles</h3></div>
                     <div class="panel-body">
                        {% set familias_disponibles = fsc.get_familias_disponibles() %}
                        {% if familias_disponibles|length > 0 %}
                        <table class="table table-hover">
                           <thead><tr><th>Código</th><th>Descripción</th><th></th></tr></thead>
                           <tbody>
                              {% for fam in familias_disponibles %}
                              <tr>
                                 <td>{{ fam.codfamilia }}</td>
                                 <td>{{ fam.nivel }}{{ fam.descripcion }}</td>
                                 <td class="text-right">
                                    <a href="#" class="btn btn-xs btn-success" onclick="añadir_familia('{{ fam.codfamilia|e('js') }}', true)" title="Añadir (con propagación)"><span class="glyphicon glyphicon-plus"></span> P</a>
                                    <a href="#" class="btn btn-xs btn-default" onclick="añadir_familia('{{ fam.codfamilia|e('js') }}', false)" title="Añadir (sin propagación)"><span class="glyphicon glyphicon-plus"></span></a>
                                 </td>
                              </tr>
                              {% endfor %}
                           </tbody>
                        </table>
                        {% else %}
                        <p class="text-muted">No hay más familias disponibles.</p>
                        {% endif %}
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="articulos">
         <div class="container-fluid" style="margin-top: 15px;">
            <div class="row"><div class="col-sm-12"><div class="panel panel-info"><div class="panel-heading"><h3 class="panel-title">Buscar artículos para añadir</h3></div><div class="panel-body"><div class="form-group"><div class="input-group"><input type="text" id="buscar_articulo" class="form-control" placeholder="Buscar por referencia o descripción..." autocomplete="off"/><span class="input-group-addon"><span class="glyphicon glyphicon-search"></span></span></div><p class="help-block">Escribe para buscar y haz clic en el resultado para añadirlo.</p></div></div></div></div></div>
            <div class="row"><div class="col-sm-12"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">Artículos asociados ({{ fsc.articulos|length }})</h3></div><div class="panel-body">
               {% if fsc.articulos|length > 0 %}
               <table class="table table-hover"><thead><tr><th>Referencia</th><th>Descripción</th><th>Familia</th><th class="text-right">Precio</th><th></th></tr></thead><tbody>
               {% for art in fsc.articulos %}
               <tr><td><a href="{{ art.url() }}">{{ art.referencia }}</a></td><td>{{ art.descripcion(fsc.codidioma, 60) }}</td><td>{{ art.codfamilia }}</td><td class="text-right">{{ fsc.show_precio(art.precio, false, true, constant('FS_NF0_ART')) }}</td><td class="text-right">{% if fsc.allow_delete %}<a href="#" class="btn btn-xs btn-danger" onclick="eliminar_articulo('{{ art.referencia|e('js') }}')" title="Quitar"><span class="glyphicon glyphicon-remove"></span></a>{% endif %}</td></tr>
               {% endfor %}
               </tbody></table>
               {% else %}<p class="text-muted">No hay artículos asociados a este opcional.</p>{% endif %}
            </div></div></div></div>
         </div>
      </div>

      {% if fsc.tarifas|length > 0 %}
      <div role="tabpanel" class="tab-pane" id="precios_tarifas">
         <form action="{{ fsc.opcional.url() }}&codtarifa={{ fsc.codtarifa|url_encode }}" method="post" class="form">
            <input type="hidden" name="guardar_precios_tarifas" value="1"/>
            <input type="hidden" name="codtarifa" value="{{ fsc.codtarifa }}"/>
            <div class="container-fluid" style="margin-top: 15px;">
               <div class="row"><div class="col-sm-8"><div class="panel panel-primary"><div class="panel-heading"><h3 class="panel-title"><span class="glyphicon glyphicon-tags"></span>&nbsp; Precios por tarifa</h3></div><div class="panel-body">
                  <p class="text-muted">Marque en qué tarifas está disponible este opcional y defina su precio.</p>
                  <table class="table table-hover"><thead><tr><th class="text-center" width="70">Activo</th><th class="text-center" width="70">Catálogo</th><th>Tarifa</th><th class="text-center" width="80">Por defecto</th><th class="text-right" width="150">Precio</th></tr></thead><tbody>
                     {% for tarifa in fsc.tarifas %}
                     <tr {% if fsc.opcional_activo_en_tarifa(tarifa.codtarifa) %}class="success"{% endif %}>
                        <td class="text-center"><input type="checkbox" name="activo_tarifa_{{ tarifa.codtarifa }}" value="1" {% if fsc.opcional_activo_en_tarifa(tarifa.codtarifa) %}checked{% endif %} onchange="toggleTarifaRow(this, '{{ tarifa.codtarifa }}')"/></td>
                        <td class="text-center"><input type="checkbox" name="catalogo_tarifa_{{ tarifa.codtarifa }}" value="1" id="catalogo_tarifa_{{ tarifa.codtarifa }}" {% if fsc.opcional_en_catalogo_tarifa(tarifa.codtarifa) %}checked{% endif %} {% if not fsc.opcional_activo_en_tarifa(tarifa.codtarifa) %}disabled{% endif %}/></td>
                        <td><b>{{ tarifa.nombre }}</b> <span class="text-muted">({{ tarifa.codtarifa }})</span></td>
                        <td class="text-center">{% if tarifa.por_defecto %}<span class="label label-primary"><span class="glyphicon glyphicon-star"></span></span>{% endif %}</td>
                        <td class="text-right"><div class="input-group input-group-sm"><input type="text" class="form-control text-right" id="precio_tarifa_{{ tarifa.codtarifa }}" name="precio_tarifa_{{ tarifa.codtarifa }}" value="{{ fsc.get_precio_tarifa(tarifa.codtarifa) }}" placeholder="0.00" autocomplete="off" {% if not fsc.opcional_activo_en_tarifa(tarifa.codtarifa) %}disabled{% endif %}/><div class="input-group-addon">{{ fsc.simbolo_divisa(tarifa.coddivisa) }}</div></div></td>
                     </tr>
                     {% endfor %}
                  </tbody></table>
               </div><div class="panel-footer text-right"><button class="btn btn-primary" type="submit"><span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar</button></div></div></div>
               <div class="col-sm-4"><div class="panel panel-info"><div class="panel-heading"><h3 class="panel-title">Información</h3></div><div class="panel-body"><p><span class="glyphicon glyphicon-check text-success"></span> <b>Activo:</b> El opcional está disponible en esa tarifa.</p><p><span class="glyphicon glyphicon-book text-info"></span> <b>Catálogo:</b> Visible en el catálogo de esa tarifa.</p><p><span class="glyphicon glyphicon-euro"></span> <b>Precio:</b> Puede ser diferente para cada tarifa.</p><p><span class="glyphicon glyphicon-star text-primary"></span> La tarifa marcada es la por defecto.</p><p><span class="glyphicon glyphicon-cog"></span> <a href="index.php?page=tarif_tarifas">Gestionar tarifas</a></p></div></div></div></div>
            </div>
         </form>
      </div>
      {% endif %}
   </div>
</div>

{% else %}
<div class="container-fluid">
   <div class="alert alert-danger">
      <span class="glyphicon glyphicon-exclamation-sign"></span>
      &nbsp;Opcional no encontrado.
      <a href="index.php?page=tarif_opcionales">Volver al listado</a>
   </div>
</div>
{% endif %}

{% include 'footer.html.twig' %}
