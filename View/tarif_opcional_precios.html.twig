{% include 'header.html.twig' %}

{% if fsc.opcional and fsc.tarifa_seleccionada %}
<script type="text/javascript">
   function toggleActivoTarifa(checkbox) {
      var precioInput = document.getElementById('precio');
      var catalogoCheckbox = document.getElementById('en_catalogo');

      if (checkbox.checked) {
         precioInput.disabled = false;
         catalogoCheckbox.disabled = false;
      } else {
         precioInput.disabled = true;
         catalogoCheckbox.disabled = true;
         catalogoCheckbox.checked = false;
      }
   }
</script>

<div class="container-fluid" style="margin-bottom: 10px;">
   <div class="row">
      <div class="col-xs-12">
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="index.php?page=tarif_opcionales&b_codtarifa={{ fsc.tarifa_seleccionada.codtarifa }}" title="Volver al listado">
               <span class="glyphicon glyphicon-arrow-left"></span>
               <span class="hidden-xs">&nbsp;Volver</span>
            </a>
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="{{ fsc.opcional.url() }}" title="Editar datos generales del opcional">
               <span class="glyphicon glyphicon-edit"></span>
               <span class="hidden-xs">&nbsp;Editar opcional</span>
            </a>
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="{{ fsc.url_actual() }}" title="Recargar">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
         </div>
      </div>
   </div>
</div>

<div class="container-fluid">
   <div class="row">
      <div class="col-sm-12">
         <div class="page-header" style="margin-top: 0;">
            <h3>
               <span class="glyphicon glyphicon-tags"></span>
               {{ fsc.opcional.codigo }}
               {% if fsc.opcional.ref_sap %}
               <small class="text-muted">[{{ fsc.opcional.ref_sap }}]</small>
               {% endif %}
               <small class="text-muted">
                  {{ fsc.opcional.nombre }}
               </small>
            </h3>
         </div>
      </div>
   </div>
</div>

{# Selector de tarifa #}
<div class="container-fluid" style="margin-bottom: 15px;">
   <div class="row">
      <div class="col-sm-4">
         <form action="{{ fsc.url() }}&id={{ fsc.opcional.id }}" method="get" class="form-inline">
            <input type="hidden" name="page" value="tarif_opcional_precios"/>
            <input type="hidden" name="id" value="{{ fsc.opcional.id }}"/>
            <div class="form-group">
               <label class="control-label"><span class="glyphicon glyphicon-tags"></span>&nbsp; Tarifa:</label>
               <select class="form-control" name="codtarifa" onchange="this.form.submit()" style="margin-left: 10px;">
                  {% for tarifa in fsc.tarifas %}
                     <option value="{{ tarifa.codtarifa }}"{% if tarifa.codtarifa == fsc.tarifa_seleccionada.codtarifa %} selected{% endif %}>{{ tarifa.nombre }}{% if tarifa.por_defecto %} ★{% endif %}</option>
                  {% endfor %}
               </select>
            </div>
         </form>
      </div>
      <div class="col-sm-8 text-right">
         <span class="label label-info" style="font-size: 14px;">
            <span class="glyphicon glyphicon-tags"></span>&nbsp;
            Precios para: <strong>{{ fsc.tarifa_seleccionada.nombre }}</strong>
            {% if fsc.tarifa_seleccionada.por_defecto %}
            <span class="glyphicon glyphicon-star" title="Tarifa por defecto"></span>
            {% endif %}
         </span>
      </div>
   </div>
</div>

<div class="container-fluid" style="margin-top: 15px;">
   <div class="row">
      {# Panel principal: Precio en tarifa #}
      <div class="col-sm-6">
         <form action="{{ fsc.url_actual() }}" method="post" class="form">
            <input type="hidden" name="guardar_precio_tarifa" value="1"/>
            <div class="panel panel-primary">
               <div class="panel-heading">
                  <h3 class="panel-title">
                     <span class="glyphicon glyphicon-tags"></span>&nbsp;
                     Precio en tarifa: {{ fsc.tarifa_seleccionada.nombre }}
                  </h3>
               </div>
               <div class="panel-body">
                  <div class="form-group">
                     <div class="checkbox">
                        <label>
                           <input type="checkbox" name="activo_tarifa" value="1"{% if fsc.esta_activo_en_tarifa() %} checked{% endif %} onchange="toggleActivoTarifa(this)"/>
                           <strong>Activo en esta tarifa</strong>
                        </label>
                        <p class="help-block">Marcar si el opcional está disponible en la tarifa "{{ fsc.tarifa_seleccionada.nombre }}".</p>
                     </div>
                  </div>

                  <hr/>

                  <div class="form-group">
                     <label>Precio</label>
                     <div class="input-group">
                        <input type="text" class="form-control text-right" id="precio" name="precio"
                           value="{{ fsc.get_precio() }}" placeholder="0.00" autocomplete="off"
                           {% if not fsc.esta_activo_en_tarifa() %}disabled{% endif %}/>
                        <div class="input-group-addon">{{ fsc.simbolo_divisa(fsc.tarifa_seleccionada.coddivisa) }}</div>
                     </div>
                     <p class="help-block">Precio del opcional en esta tarifa (sin impuestos).</p>
                  </div>

                  <div class="form-group">
                     <div class="checkbox">
                        <label>
                           <input type="checkbox" name="en_catalogo" id="en_catalogo" value="1"
                              {% if fsc.esta_en_catalogo() %} checked{% endif %}
                              {% if not fsc.esta_activo_en_tarifa() %}disabled{% endif %}/>
                           Mostrar en catálogo
                        </label>
                        <p class="help-block">Marcar si el opcional debe aparecer en el catálogo de esta tarifa.</p>
                     </div>
                  </div>
               </div>
               <div class="panel-footer text-right">
                  <button class="btn btn-primary" type="submit">
                     <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar
                  </button>
               </div>
            </div>
         </form>
      </div>

      {# Panel secundario: Información del opcional #}
      <div class="col-sm-6">
         <div class="panel panel-info">
            <div class="panel-heading">
               <h3 class="panel-title">
                  <span class="glyphicon glyphicon-info-sign"></span>&nbsp;
                  Información del opcional
               </h3>
            </div>
            <div class="panel-body">
               <dl class="dl-horizontal">
                  <dt>Código</dt>
                  <dd>{{ fsc.opcional.codigo }}</dd>

                  <dt>REF</dt>
                  <dd>
                     {% if fsc.opcional.ref_sap %}
                     {{ fsc.opcional.ref_sap }}
                     {% else %}
                     <span class="text-muted">-</span>
                     {% endif %}
                  </dd>

                  <dt>Nombre</dt>
                  <dd>{{ fsc.opcional.nombre }}</dd>

                  <dt>Descripción</dt>
                  <dd>
                     {% if fsc.opcional.descripcion %}
                     {{ fsc.opcional.descripcion }}
                     {% else %}
                     <span class="text-muted">Sin descripción</span>
                     {% endif %}
                  </dd>

                  <dt>Estado global</dt>
                  <dd>
                     {% if fsc.opcional.activo %}
                     <span class="label label-success">Activo</span>
                     {% else %}
                     <span class="label label-danger">Inactivo</span>
                     {% endif %}
                  </dd>
               </dl>
               <hr/>
               <p><b>Familias asociadas:</b> {{ fsc.familias_asignadas|length }}</p>
               {% if fsc.familias_asignadas|length > 0 %}
               <p>
                  {% for fam in fsc.familias_asignadas %}
                  <span class="label label-info">{{ fam.codfamilia }}</span>
                  {% endfor %}
               </p>
               {% endif %}
               <p><b>Artículos asociados:</b> {{ fsc.articulos|length }}</p>
            </div>
            <div class="panel-footer">
               <a href="{{ fsc.opcional.url() }}" class="btn btn-sm btn-default">
                  <span class="glyphicon glyphicon-edit"></span>&nbsp; Editar datos generales
               </a>
            </div>
         </div>
      </div>
   </div>

   {# Panel: Resumen de precios en todas las tarifas #}
   <div class="row">
      <div class="col-sm-12">
         <div class="panel panel-default">
            <div class="panel-heading">
               <h3 class="panel-title">
                  <span class="glyphicon glyphicon-list"></span>&nbsp;
                  Configuración en todas las tarifas
               </h3>
            </div>
            <div class="table-responsive">
               <table class="table table-hover">
                  <thead>
                     <tr>
                        <th>Tarifa</th>
                        <th class="text-center">Por defecto</th>
                        <th class="text-center">Activo</th>
                        <th class="text-center">En catálogo</th>
                        <th class="text-right">Precio</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     {% set precios_tarifas = fsc.get_precios_todas_tarifas() %}
                     {% for codtarifa, info in precios_tarifas %}
                     <tr{% if info.activo %} class="success"{% endif %}{% if codtarifa == fsc.tarifa_seleccionada.codtarifa %} style="font-weight: bold;"{% endif %}>
                        <td>
                           {{ info.tarifa.nombre }}
                           {% if codtarifa == fsc.tarifa_seleccionada.codtarifa %}
                           <span class="label label-primary">actual</span>
                           {% endif %}
                        </td>
                        <td class="text-center">
                           {% if info.tarifa.por_defecto %}
                           <span class="glyphicon glyphicon-star text-warning"></span>
                           {% endif %}
                        </td>
                        <td class="text-center">
                           {% if info.activo %}
                           <span class="glyphicon glyphicon-ok text-success"></span>
                           {% else %}
                           <span class="glyphicon glyphicon-remove text-muted"></span>
                           {% endif %}
                        </td>
                        <td class="text-center">
                           {% if info.en_catalogo %}
                           <span class="glyphicon glyphicon-ok text-success"></span>
                           {% else %}
                           <span class="glyphicon glyphicon-remove text-muted"></span>
                           {% endif %}
                        </td>
                        <td class="text-right">
                           {% if info.activo %}
                           {{ fsc.show_precio(info.precio, fsc.tarifa_seleccionada.coddivisa, true, constant('FS_NF0_ART')) }}
                           {% else %}
                           <span class="text-muted">-</span>
                           {% endif %}
                        </td>
                        <td class="text-right">
                           {% if codtarifa != fsc.tarifa_seleccionada.codtarifa %}
                           <a href="{{ fsc.url() }}&id={{ fsc.opcional.id }}&codtarifa={{ codtarifa }}" class="btn btn-xs btn-default" title="Editar precio en {{ info.tarifa.nombre }}">
                              <span class="glyphicon glyphicon-edit"></span>
                           </a>
                           {% endif %}
                        </td>
                     </tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
         </div>
      </div>
   </div>

   {# Panel: Artículos asociados #}
   {% if fsc.articulos|length > 0 %}
   <div class="row">
      <div class="col-sm-12">
         <div class="panel panel-default">
            <div class="panel-heading">
               <h3 class="panel-title">
                  <span class="glyphicon glyphicon-th-list"></span>&nbsp;
                  Artículos que incluyen este opcional ({{ fsc.articulos|length }})
               </h3>
            </div>
            <div class="table-responsive">
               <table class="table table-hover table-condensed">
                  <thead>
                     <tr>
                        <th>Referencia</th>
                        <th>Descripción</th>
                        <th>Familia</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for art in fsc.articulos %}
                     <tr>
                        <td><a href="{{ art.url_tarifario() }}">{{ art.referencia }}</a></td>
                        <td>{{ art.descripcion(fsc.codidioma, 60) }}</td>
                        <td>{{ art.codfamilia }}</td>
                        <td class="text-right">
                           <a href="index.php?page=tarif_articulo_precios&ref={{ art.referencia }}&codtarifa={{ fsc.tarifa_seleccionada.codtarifa }}" class="btn btn-xs btn-info" title="Ver precios del artículo">
                              <span class="glyphicon glyphicon-tags"></span>
                           </a>
                        </td>
                     </tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
         </div>
      </div>
   </div>
   {% endif %}
</div>

{% else %}
<div class="container-fluid">
   <div class="alert alert-danger">
      <span class="glyphicon glyphicon-exclamation-sign"></span>
      &nbsp;{% if not fsc.opcional %}Opcional no encontrado.{% else %}No hay tarifas configuradas.{% endif %}
      <a href="index.php?page=tarif_opcionales">Volver al listado</a>
   </div>
</div>
{% endif %}

{% include 'footer.html.twig' %}
