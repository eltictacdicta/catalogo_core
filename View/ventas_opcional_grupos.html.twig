{{ include('header.html.twig') }}

<script type="text/javascript">
function delete_grupo(url, id) {
    bootbox.confirm({
        message: '{{ 'optional-group-confirm-delete'|trans|e('js') }}',
        title: '<b>{{ 'attention'|trans|default('Atención') }}</b>',
        callback: function (result) {
            if (result) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = url;

                var deleteField = document.createElement('input');
                deleteField.type = 'hidden';
                deleteField.name = 'delete';
                deleteField.value = id;
                form.appendChild(deleteField);

                var csrfField = document.createElement('input');
                csrfField.type = 'hidden';
                csrfField.name = 'form_token';
                csrfField.value = document.querySelector('input[name="form_token"]').value;
                form.appendChild(csrfField);

                document.body.appendChild(form);
                form.submit();
            }
        }
    });
}
</script>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-header">
                <h1>
                    <i class="fa fa-object-group" aria-hidden="true"></i>&nbsp; {{ 'optional-groups'|trans }}
                    <span class="badge">{{ fsc.resultados|length }}</span>
                    <a class="btn btn-xs btn-default" href="index.php?page=ventas_opcionales" title="{{ 'optionals'|trans }}">
                        <span class="glyphicon glyphicon-arrow-left"></span>
                    </a>
                    <a class="btn btn-xs btn-default" href="{{ fsc.url() }}" title="{{ 'reload'|trans }}">
                        <span class="glyphicon glyphicon-refresh"></span>
                    </a>
                    <a class="btn btn-xs btn-success" href="index.php?page=ventas_opcional_grupo" title="{{ 'optional-group-new'|trans }}">
                        <span class="glyphicon glyphicon-plus"></span>
                        <span class="hidden-xs">&nbsp;{{ 'optional-group-new'|trans }}</span>
                    </a>
                </h1>
            </div>

            <form class="form-inline" method="get" action="{{ fsc.url() }}">
                <div class="form-group">
                    <input type="text" name="search" class="form-control" placeholder="{{ 'search'|trans }}..." value="{{ fsc.search_query }}" autocomplete="off"/>
                </div>
                <button type="submit" class="btn btn-primary">
                    <span class="glyphicon glyphicon-search"></span>
                </button>
                {% if fsc.search_query %}
                <a href="{{ fsc.url() }}" class="btn btn-default">{{ 'clear'|trans }}</a>
                {% endif %}
            </form>

            <div class="table-responsive" style="margin-top: 15px;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="text-left">{{ 'optional-code'|trans }}</th>
                            <th class="text-left">{{ 'optional-name'|trans }}</th>
                            <th class="text-center">{{ 'optional-group-variants'|trans }}</th>
                            <th class="text-center">{{ 'optional-group-exclusive'|trans }}</th>
                            <th class="text-center">{{ 'status'|trans|default('Estado') }}</th>
                            <th class="text-right">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for grupo in fsc.resultados %}
                        <tr{% if not grupo.activo %} class="danger"{% endif %}>
                            <td><a href="{{ grupo.url() }}">{{ grupo.codigo }}</a></td>
                            <td>{{ grupo.nombre }}</td>
                            <td class="text-center">{{ grupo.count_opcionales() }}</td>
                            <td class="text-center">
                                {% if grupo.exclusivo %}
                                    <span class="label label-info">{{ 'yes'|trans|default('Sí') }}</span>
                                {% else %}
                                    <span class="label label-default">{{ 'no'|trans|default('No') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if grupo.activo %}
                                    <span class="label label-success">{{ 'active'|trans|default('Activo') }}</span>
                                {% else %}
                                    <span class="label label-danger">{{ 'inactive'|trans|default('Inactivo') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-right">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-default" href="{{ grupo.url() }}" title="{{ 'edit'|trans|default('Editar') }}">
                                        <span class="glyphicon glyphicon-edit"></span>
                                    </a>
                                    {% if fsc.allow_delete %}
                                    <a class="btn btn-sm btn-danger" onclick="delete_grupo('{{ fsc.url() }}', '{{ grupo.id }}')" title="{{ 'delete'|trans }}">
                                        <span class="glyphicon glyphicon-trash"></span>
                                    </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr class="warning">
                            <td colspan="6">{{ 'optional-group-no-results'|trans }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{{ csrf_field() }}
{{ include('footer.html.twig') }}
